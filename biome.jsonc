{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",

  // Biome owns formatting and linting for this monorepo. ESLint is retained in two
  // places only:
  //
  //   * packages/aws-durable-execution-sdk-js-eslint-plugin -- needs it to test its
  //     own rules via RuleTester.
  //   * packages/aws-durable-execution-sdk-js-examples -- runs that published plugin's
  //     `no-nested-durable-operations` against the examples. Biome cannot host ESLint
  //     plugins, and the examples are the code customers copy. See that package's
  //     eslint.config.mjs and the `durable-rules` job in .github/workflows/lint.yml.
  //
  // KNOWN COVERAGE GAPS vs the previous ESLint + Prettier setup. These are real
  // losses, listed so they are not rediscovered later:
  //
  // 1. Type-aware linting is largely gone. The testing package previously used
  //    `tseslint.configs.strictTypeChecked` + `stylisticTypeChecked`. Three
  //    async-safety rules are recovered below via the `types` domain
  //    (noFloatingPromises, noMisusedPromises, useAwaitThenable). Still missing, with
  //    NO Biome equivalent at any severity:
  //      - the `any`-propagation family: no-unsafe-assignment, no-unsafe-return,
  //        no-unsafe-member-access, no-unsafe-call, no-unsafe-argument
  //      - restrict-template-expressions
  //      - no-confusing-void-expression
  //      - prefer-promise-reject-errors
  //      - no-unnecessary-type-parameters
  //    Available but left off, one line away if wanted: noUnsafeTypeAssertion
  //    (the testing package carried 23 suppressions of the ESLint equivalent) and
  //    noUnnecessaryConditions. `tsc --noEmit` still runs and still catches type
  //    errors, but it does not implement any of these rules.
  //
  // 2. TSDoc syntax is unchecked. `eslint-plugin-tsdoc`'s `tsdoc/syntax` has no Biome
  //    equivalent. API Extractor still parses TSDoc during `npm run api:extract` and
  //    remains the backstop -- it currently reports unresolved @link references in
  //    src/types/batch.ts.
  //
  // 3. Markdown and YAML are no longer formatted at all. The old lint-staged glob
  //    passed *.md and *.yml through Prettier; Biome has no formatter for either
  //    language, so the new glob cannot include them. Nothing enforces formatting on
  //    those files now. Restoring it would mean keeping Prettier for those two
  //    extensions only.
  //
  // 4. no-duplicate-imports has no Biome equivalent (was "error" in the core SDK and
  //    insight configs).

  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },

  "files": {
    "includes": [
      "**",
      "!**/node_modules",
      "!**/dist",
      "!**/dist-cjs",
      "!**/dist-types",
      "!**/build",
      "!**/coverage",
      "!**/.rollup.cache",
      "!**/*.tsbuildinfo",
      "!package-lock.json",

      // API Extractor owns the formatting of the reports it generates. Reformatting them
      // makes every regeneration produce a diff, which defeats the point of committing
      // them: the report is meant to show real API changes in review, not whitespace
      // churn. It would also mean the committed files never match what
      // `npm run api:extract` produces.
      "!api-extractor/*.api.json",
      "!api-extractor/*.api.md",

      // Recorded execution histories are generated fixtures, not sources. The largest is
      // ~10 MiB, well past Biome's per-file ceiling, and formatting them would produce an
      // unreviewable diff.
      "!**/*.history.json"
    ]
  },

  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 80
  },

  // These mirror Prettier's defaults, which is what the repo used: `.prettierrc` was an
  // empty file, so every Prettier setting was at its default. Stating them explicitly
  // keeps the formatter's behaviour from drifting with Biome's own defaults.
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all",
      "arrowParentheses": "always"
    }
  },

  "linter": {
    "enabled": true,

    // Auto-enabled by the `jest` dependency anyway; stated so it survives dependency
    // changes. Covers what eslint-plugin-jest's recommended set gave us
    // (noFocusedTests, noSkippedTests, noDuplicateTestHooks, ...).
    "domains": {
      "test": "recommended"
    },

    "rules": {
      "preset": "recommended",

      "correctness": {
        "noUnusedVariables": "warn",
        "noUnusedFunctionParameters": "warn",
        "noUnusedImports": "warn"
      },

      "suspicious": {
        "noExplicitAny": "warn",
        "noConsole": "warn",
        "noDebugger": "warn"
      },

      "style": {
        // NOT ENABLED, deliberately. All of these are recommended by Biome but were not
        // enforced under ESLint, and turning them on would rewrite thousands of call
        // sites as part of a toolchain migration -- which would make this change
        // unreviewable and bury any real behavioural difference.
        //
        //   useImportType            (~1089 sites) safe autofix
        //   noNonNullAssertion       (~666 sites)  needs judgement per site, no autofix
        //   useNodejsImportProtocol  (~94 sites)   safe autofix, but rewrites imports in
        //                                          published SDK code, so it deserves its
        //                                          own change with its own bundler check
        //   useTemplate              (~60 sites)   safe autofix
        //
        // Each is a one-line change plus `biome check --write --only=<rule>`, and none
        // is dropped on principle -- they are follow-ups, not rejections.
        "useImportType": "off",
        "noNonNullAssertion": "off",
        "useNodejsImportProtocol": "off",
        "useTemplate": "off"
      },

      "complexity": {
        // Same reasoning as the style rules above: never enforced, ~23 sites, pure
        // preference. `biome check --write --only=complexity/useLiteralKeys` when wanted.
        // The `noUseless*` rules in this group are deliberately left ON: they flag dead
        // code rather than style, and are low volume.
        "useLiteralKeys": "off"
      },

      "nursery": {
        // Replaces `@typescript-eslint/explicit-function-return-type`, which the core SDK
        // and insight configs set to "warn". Note this rule is in Biome's nursery group,
        // so it is NOT covered by semver and may change between minor releases.
        "useExplicitReturnType": "warn",

        // Async-safety rules recovered from the type-aware set the testing package used
        // to get via `tseslint.configs.strictTypeChecked`. These belong to Biome's
        // `types` domain, so enabling them turns on the scanner: lint goes from ~0.5s to
        // ~3s for the monorepo and Biome reads .d.ts files from node_modules. For an SDK
        // whose entire job is orchestrating asynchronous work, that is worth paying.
        //
        // They are "warn" rather than "error" deliberately. There are ~77 existing
        // violations: 57 in test files, and 17 in shipped source concentrated in
        // checkpoint-manager.ts, run-in-child-context-handler.ts and
        // replay-validation.ts. Those deserve a human triage pass, not a mechanical fix
        // folded into a toolchain migration, and warnings do not fail `biome ci`.
        //
        // Like all nursery rules these are outside Biome's semver guarantees.
        "noFloatingPromises": "warn",
        "noMisusedPromises": "warn",
        "useAwaitThenable": "warn"
      }
    }
  },

  // Import sorting was never enforced by the old setup. Left off so this migration does
  // not reorder imports across the entire repository.
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "off"
      }
    }
  },

  "overrides": [
    {
      // Parity with the old per-package configs, which turned `no-explicit-any` off in
      // test files. Return types on test callbacks are noise for the same reason.
      "includes": ["**/*.test.ts", "**/*.test.tsx", "**/*.test.mts"],
      "linter": {
        "rules": {
          "suspicious": { "noExplicitAny": "off" },
          "nursery": { "useExplicitReturnType": "off" }
        }
      }
    },

    {
      // Kebab-case filenames were only ever enforced in the core SDK's `src`, via the
      // local `eslint-plugin-filename-convention` package (now deleted). Keeping the same
      // scope matters: the conformance handlers use snake_case names that are part of the
      // cross-SDK contract with aws-durable-execution-conformance-tests, and the insight
      // packages use camelCase throughout. Neither should be renamed by a lint rule.
      "includes": [
        "packages/aws-durable-execution-sdk-js/src/**/*.ts",
        "!packages/aws-durable-execution-sdk-js/src/**/__mocks__/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "useFilenamingConvention": {
              "level": "error",
              "options": {
                "filenameCases": ["kebab-case"],
                "strictCase": true,
                "requireAscii": true
              }
            }
          }
        }
      }
    },

    {
      // Examples, conformance handlers and the packaging smoke tests print to stdout on
      // purpose, and are not part of the published API surface.
      "includes": [
        "packages/aws-durable-execution-sdk-js-examples/**",
        "packages/aws-durable-execution-sdk-js-conformance-tests/**",
        "packages/aws-durable-execution-sdk-js-conformance-tests-otel/**",
        "packages/cjs-integration-test/**",
        "packages/esm-integration-test/**",
        "packages/cdk-bundling-integration-test/**",
        "packages/lambda-runtime-detection-integration-test/**",
        ".github/**"
      ],
      "linter": {
        "rules": {
          "suspicious": { "noConsole": "off" },
          "nursery": { "useExplicitReturnType": "off" }
        }
      }
    },

    {
      // The wire model is the SDK's own declaration of the durable execution protocol, and
      // nothing portable can depend on the AWS SDK. Keeping it AWS-free is what lets a
      // transport for another compute type be written against these types, so it is
      // enforced rather than left to review. The parity test is exempt (next override):
      // comparing our declarations to the service model is precisely its job, and it
      // imports the AWS types for that.
      "includes": [
        "packages/aws-durable-execution-sdk-js/src/types/wire/**/*.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@aws-sdk/**", "aws-lambda"],
                    "message": "The wire model must stay free of AWS types so it can describe the protocol for any compute type. If the service model changed, update the declarations here and let wire-model.aws-sdk-parity.test.ts verify them."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "packages/aws-durable-execution-sdk-js/src/types/wire/**/*.aws-sdk-parity.test.ts"
      ],
      "linter": {
        "rules": { "style": { "noRestrictedImports": "off" } }
      }
    },

    /**
     * Structural rules for the Workflow Insight packages.
     *
     * These exist because the alternative is a convention nobody can enforce. The
     * refactor that created `@aws/durable-execution-sdk-js-insight-core` was motivated by
     * a cross-package relative import that had grown up unnoticed, and review then showed
     * that a host-specific import in shared code was equally invisible: an `electron`
     * import in a core module that no test happened to cover passed every check and every
     * build.
     *
     * Modules that belong to exactly one host: `vscode`, `electron`,
     * `@modelcontextprotocol/sdk`. Shared code (insight-core) may import none of them;
     * each host may import only its own. This list mirrors `HOST_MODULES` in
     * packages/aws-durable-execution-sdk-js-insight-core/src/hostModuleScan.ts, which is
     * where the tested, authoritative version lives.
     *
     * NOTE ON ENFORCEMENT: unlike the old ESLint setup, these now run in CI via
     * `biome ci` (see .github/workflows/lint.yml), not only on pre-commit where
     * `--no-verify` bypassed them. The `hostAgnostic.test.ts` guards must still stay --
     * they assert the same invariant from inside the test suite.
     */
    {
      "includes": [
        "packages/aws-durable-execution-sdk-js-insight-core/**/*.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "vscode": "\"vscode\" belongs to a different host process and is not available here. Shared, host-free code belongs in @aws/durable-execution-sdk-js-insight-core; express what you need through the HostPort interface and let each host implement it.",
                  "electron": "\"electron\" belongs to a different host process and is not available here. Shared, host-free code belongs in @aws/durable-execution-sdk-js-insight-core; express what you need through the HostPort interface and let each host implement it.",
                  "@modelcontextprotocol/sdk": "\"@modelcontextprotocol/sdk\" belongs to a different host process and is not available here. Shared, host-free code belongs in @aws/durable-execution-sdk-js-insight-core; express what you need through the HostPort interface and let each host implement it."
                },
                "patterns": [
                  {
                    "group": [
                      "vscode/**",
                      "electron/**",
                      "@modelcontextprotocol/sdk/**"
                    ],
                    "message": "This module belongs to a different host process and is not available here. Express what you need through the HostPort interface in @aws/durable-execution-sdk-js-insight-core."
                  },
                  {
                    "group": ["../../**"],
                    "message": "Do not reach into a sibling package by relative path. Depend on it (e.g. `@aws/durable-execution-sdk-js-insight-core`) and import by name, so the dependency is declared and the boundary is real."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/aws-durable-execution-sdk-js-insight-mcp/**/*.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "vscode": "\"vscode\" belongs to a different host process and is not available here. Express what you need through the HostPort interface in @aws/durable-execution-sdk-js-insight-core.",
                  "electron": "\"electron\" belongs to a different host process and is not available here. Express what you need through the HostPort interface in @aws/durable-execution-sdk-js-insight-core."
                },
                "patterns": [
                  {
                    "group": ["vscode/**", "electron/**"],
                    "message": "This module belongs to a different host process and is not available here."
                  },
                  {
                    "group": ["../../**"],
                    "message": "Do not reach into a sibling package by relative path. Depend on it and import by name, so the dependency is declared and the boundary is real."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "packages/aws-durable-execution-sdk-js-insight-vscode/**/*.ts",
        "packages/aws-durable-execution-sdk-js-insight-vscode/**/*.tsx"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "electron": "\"electron\" belongs to a different host process and is not available here. Express what you need through the HostPort interface in @aws/durable-execution-sdk-js-insight-core.",
                  "@modelcontextprotocol/sdk": "\"@modelcontextprotocol/sdk\" belongs to a different host process and is not available here. Express what you need through the HostPort interface in @aws/durable-execution-sdk-js-insight-core."
                },
                "patterns": [
                  {
                    "group": ["electron/**", "@modelcontextprotocol/sdk/**"],
                    "message": "This module belongs to a different host process and is not available here."
                  },
                  {
                    "group": ["../../**"],
                    "message": "Do not reach into a sibling package by relative path. Depend on it and import by name, so the dependency is declared and the boundary is real."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "packages/aws-durable-execution-sdk-js-insight-desktop/**/*.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "vscode": "\"vscode\" belongs to a different host process and is not available here. Express what you need through the HostPort interface in @aws/durable-execution-sdk-js-insight-core.",
                  "@modelcontextprotocol/sdk": "\"@modelcontextprotocol/sdk\" belongs to a different host process and is not available here. Express what you need through the HostPort interface in @aws/durable-execution-sdk-js-insight-core."
                },
                "patterns": [
                  {
                    "group": ["vscode/**", "@modelcontextprotocol/sdk/**"],
                    "message": "This module belongs to a different host process and is not available here."
                  },
                  {
                    "group": ["../../**"],
                    "message": "Do not reach into a sibling package by relative path. Depend on it and import by name, so the dependency is declared and the boundary is real."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
