{
  "name": "@aws/durable-execution-sdk-js-telemetry-cdk",
  "version": "0.1.0",
  "private": true,
  "description": "CDK stack to deploy Durable Execution Telemetry destination infrastructure",
  "scripts": {
    "build:deps": "npm --prefix ../../aws-durable-execution-sdk-js run build && npm --prefix .. run build",
    "build": "tsc -p tsconfig.build.json",
    "pretypecheck": "npm run build:deps",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run build:deps",
    "test": "vitest run",
    "presynth": "npm run build:deps",
    "synth": "cdk synth",
    "predeploy": "npm run build:deps",
    "deploy": "cdk deploy",
    "destroy": "cdk destroy"
  },
  "dependencies": {
    "@aws-sdk/client-lambda": "^3.1149.0",
    "@aws-sdk/client-rds": "^3.1149.0",
    "@aws-sdk/client-redshift-data": "^3.1149.0",
    "@aws/durable-execution-sdk-js": "file:../../aws-durable-execution-sdk-js",
    "@aws/durable-execution-sdk-js-telemetry-exporter": "file:..",
    "aws-cdk-lib": "^2.273.0",
    "constructs": "^10.8.1"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.164",
    "aws-cdk": "^2.1145.0",
    "esbuild": "^0.28.2",
    "@typescript/native": "npm:typescript@^7.0.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^5.1.0"
  }
}
