      "input": "com.acme.Outer$PaymentError",
      "expected": "PaymentError"
    },
    {
      "id": "A4",
      "input": "a.b.Outer$Inner$PaymentError",
      "expected": "PaymentError"
    },
    {
      "id": "A5",
      "input": "__main__.PaymentError",
      "expected": "PaymentError"
    },
    {
      "id": "A6",
      "input": "States.Timeout",
      "expected": "Timeout"
    },
    {
      "id": "A7",
      "input": "trailing.",
      "expected": "trailing."
    },
    {
      "id": "A8",
      "input": "Outer$",
      "expected": "Outer$"
    },
    {
