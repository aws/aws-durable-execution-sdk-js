    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.1",
    "@types/node": "^22.20.5",
    "rollup": "^4.68.0",
    "tslib": "^2.9.1",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  }
}
