{
  "name": "@aws/durable-execution-sdk-js-eslint-plugin",
  "version": "1.1.1",
  "description": "ESLint plugin for AWS Lambda durable functions best practices",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/aws/aws-durable-execution-sdk-js.git",
    "directory": "packages/aws-durable-execution-sdk-js-eslint-plugin"
  },
  "homepage": "https://github.com/aws/aws-durable-execution-sdk-js/tree/main/packages/aws-durable-execution-sdk-js-eslint-plugin",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "test": "jest",
    "clean": "rm -rf dist node_modules .tsbuildinfo",
    "lint": "biome check src --diagnostic-level=error",
    "lint:fix": "biome check --write src"
  },
  "keywords": [
    "eslint",
    "eslint-plugin",
    "durable-functions",
    "aws-lambda"
  ],
  "peerDependencies": {
    "eslint": ">=8.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@types/eslint": "^8.56.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.0.0",
    "@typescript-eslint/parser": "^8.44.0",
    "eslint": "^8.57.0",
    "jest": "^30.5.1",
    "ts-jest": "^29.4.12",
    "typescript": "^6.0.3"
  },
  "files": [
    "dist/**/*",
    "README.md"
  ],
  "private": false
}
