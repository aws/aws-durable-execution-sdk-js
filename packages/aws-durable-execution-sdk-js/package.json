{
  "name": "@aws/durable-execution-sdk-js",
  "description": "AWS Durable Execution Language SDK for TypeScript",
  "license": "Apache-2.0",
  "version": "3.0.0",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/aws/aws-durable-execution-sdk-js.git",
    "directory": "packages/aws-durable-execution-sdk-js"
  },
  "homepage": "https://github.com/aws/aws-durable-execution-sdk-js/tree/main/packages/aws-durable-execution-sdk-js",
  "engines": {
    "node": ">=22"
  },
  "main": "./dist-cjs/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist-types/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist-types/index.d.ts",
        "default": "./dist-cjs/index.js"
      }
    }
  },
  "files": [
    "index.d.mts",
    "dist/",
    "dist-cjs/",
    "dist-types/",
    "!dist-types/**/*.test.d.ts",
    "!dist-types/**/*.test-d.d.ts",
    "!dist-types/**/*.d.ts.map"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "concurrently npm:build:esm npm:build:cjs npm:build:types",
    "build:esm": "rollup --config rollup.config.mjs --environment MODE:esm",
    "build:cjs": "rollup --config rollup.config.mjs --environment MODE:cjs",
    "build:types": "rimraf dist-types tsconfig.build.tsbuildinfo && tsc -p tsconfig.build.json --emitDeclarationOnly --declaration --outDir dist-types",
    "test": "npm run typecheck && vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:all": "vitest run",
    "test:all:coverage": "vitest run --coverage",
    "lint": "biome check src --diagnostic-level=error",
    "lint:fix": "biome check --write src",
    "prepublishOnly": "npm test && npm run lint && npm run build",
    "check:package": "attw --pack . && publint --strict",
    "clean": "rm -rf node_modules dist dist-cjs dist-types coverage .tsbuildinfo .rollup.cache",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "2.5.15",
    "@vitest/coverage-v8": "^5.1.0",
    "publint": "^0.3.25",
    "rimraf": "^6.1.4",
    "@typescript/native": "npm:typescript@^7.0.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@aws-sdk/client-lambda": "^3.1164.0",
    "@types/aws-lambda": "^8.10.164"
  },
  "private": false
}
