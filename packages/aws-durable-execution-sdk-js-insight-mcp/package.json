  "private": false,
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/aws/aws-durable-execution-sdk-js.git",
    "directory": "packages/aws-durable-execution-sdk-js-insight-mcp"
  },
  "engines": {
    "node": ">=20"
