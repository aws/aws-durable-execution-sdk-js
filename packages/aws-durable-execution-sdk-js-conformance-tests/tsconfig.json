{
  "compilerOptions": {
    "rootDir": "./handlers",
    "types": ["node", "jest"],
    "target": "ES2022",
    "module": "ESNext",
    "lib": ["ES2022"],
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": false,
    "sourceMap": true,
    "moduleResolution": "bundler",
    "noEmitOnError": false
  },
  "include": ["handlers/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
