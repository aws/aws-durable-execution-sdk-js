{
  "name": "@aws/durable-execution-sdk-js-graph",
  "description": "POC: LangGraph-shaped agent graph runtime on AWS Lambda durable functions",
  "version": "0.0.1",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "main": "./dist-cjs/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist-types/index.d.ts",
  "scripts": {
    "clean": "rm -rf dist dist-cjs dist-types node_modules coverage .tsbuildinfo .rollup.cache *.tsbuildinfo",
    "build": "concurrently npm:build:esm npm:build:cjs npm:build:types",
    "build:esm": "rollup --config rollup.config.mjs --environment MODE:esm",
    "build:cjs": "rollup --config rollup.config.mjs --environment MODE:cjs",
    "build:types": "tsc --project tsconfig.build.json --outDir dist-types",
    "test": "tsc --noEmit && jest --config jest.config.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist-types/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist-cjs/index.js"
    }
  },
  "files": [
    "dist/",
    "dist-cjs/",
    "dist-types"
  ],
  "devDependencies": {
    "@aws/durable-execution-sdk-js-testing": "*",
    "@types/aws-lambda": "^8.10.150",
    "jest": "^30.0.3",
    "typescript": "^5.8.3"
  },
  "peerDependencies": {
    "@aws/durable-execution-sdk-js": ">=2.3.0"
  },
  "private": true
}
