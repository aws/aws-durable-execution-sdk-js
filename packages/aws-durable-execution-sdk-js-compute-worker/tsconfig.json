{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "rootDir": "./src",
    "types": ["node"],
    "declaration": true,
    "outDir": "./dist",
    "sourceMap": true,
    "declarationMap": true,
    "esModuleInterop": true,
    "noImplicitAny": true,
    "isolatedModules": true,
    "module": "esnext",
    "moduleResolution": "bundler"
  },
  "include": ["src"]
}
