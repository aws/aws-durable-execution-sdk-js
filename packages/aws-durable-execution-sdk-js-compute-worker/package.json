{
  "name": "@aws/durable-execution-sdk-js-compute-worker",
  "description": "Runs jobs from durable functions on compute defined outside the function. The microvm subpath runs inside an AWS Lambda MicroVM, and the agentcore subpath inside an Amazon Bedrock AgentCore Runtime agent: each receives a job from a durable function's operation, sends heartbeats, and reports the result",
  "version": "0.1.0-alpha.0",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/aws/aws-durable-execution-sdk-js.git",
    "directory": "packages/aws-durable-execution-sdk-js-compute-worker"
  },
  "homepage": "https://github.com/aws/aws-durable-execution-sdk-js/tree/main/packages/aws-durable-execution-sdk-js-compute-worker",
  "engines": {
    "node": ">=22"
  },
  "main": "./dist-cjs/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist-types/index.d.ts",
  "scripts": {
    "clean": "rm -rf dist dist-cjs dist-types node_modules coverage .tsbuildinfo .rollup.cache",
    "build": "concurrently npm:build:esm npm:build:cjs npm:build:types",
    "build:esm": "rollup --config rollup.config.mjs --environment MODE:esm",
    "build:cjs": "rollup --config rollup.config.mjs --environment MODE:cjs",
    "build:types": "tsc --project tsconfig.build.json --outDir dist-types",
    "prepublishOnly": "npm run build && npm run test",
    "lint": "biome check src --diagnostic-level=error",
    "lint:fix": "biome check --write src",
    "prebuild": "rm -rf dist dist-cjs dist-types",
    "test": "tsc --noEmit && vitest run --coverage"
  },
  "exports": {
    ".": {
      "types": "./dist-types/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist-cjs/index.js"
    },
    "./microvm": {
      "types": "./dist-types/microvm/index.d.ts",
      "import": "./dist/microvm.mjs",
      "require": "./dist-cjs/microvm.js"
    },
    "./agentcore": {
      "types": "./dist-types/agentcore/index.d.ts",
      "import": "./dist/agentcore.mjs",
      "require": "./dist-cjs/agentcore.js"
    }
  },
  "files": [
    "dist/",
    "dist-cjs/",
    "dist-types"
  ],
  "dependencies": {
    "@aws-sdk/client-lambda": "^3.1164.0",
    "@aws-sdk/client-lambda-microvms": "^3.1164.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@vitest/coverage-v8": "^5.1.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^5.1.0"
  },
  "private": false
}
