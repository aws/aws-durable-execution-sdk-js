    "@aws-sdk/client-cloudwatch-logs": "^3.1149.0",
    "@aws-sdk/client-dynamodb": "^3.1149.0",
    "@aws-sdk/client-glue": "^3.1149.0",
    "@aws-sdk/client-rds-data": "^3.1149.0",
    "@aws-sdk/client-redshift-data": "^3.1149.0",
    "@aws-sdk/client-sqs": "^3.1149.0",
    "@aws-sdk/credential-providers": "^3.1149.0",
    "@aws-sdk/util-dynamodb": "^3.996.9",
    "@jitl/quickjs-singlefile-cjs-release-sync": "^0.32.0",
    "@smithy/signature-v4": "^5.7.4",
    "node-llama-cpp": "^3.22.1",
    "quickjs-emscripten-core": "^0.32.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^20.19.43",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.14",
    "typescript": "^6.0.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/src/**/*.test.ts"
