{
  "name": "@aws/durable-execution-sdk-js-lite-telemetry",
  "description": "Execution telemetry plugin with CloudWatch Logs, Aurora PostgreSQL, DynamoDB, S3, SQS, Firehose, EventBridge and Redshift exporters for the dependency-free lite durable execution SDK",
  "license": "Apache-2.0",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/aws/aws-durable-execution-sdk-js.git",
    "directory": "packages/aws-durable-execution-sdk-js-lite-telemetry"
  },
  "engines": {
    "node": ">=22.12"
  },
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./cloudwatch-logs": {
      "types": "./src/exporters/cloudwatch-logs.d.ts",
      "default": "./src/exporters/cloudwatch-logs.js"
    },
    "./aurora": {
      "types": "./src/exporters/aurora.d.ts",
      "default": "./src/exporters/aurora.js"
    },
    "./dynamodb": {
      "types": "./src/exporters/dynamodb.d.ts",
      "default": "./src/exporters/dynamodb.js"
    },
    "./s3": {
      "types": "./src/exporters/s3.d.ts",
      "default": "./src/exporters/s3.js"
    },
    "./sqs": {
      "types": "./src/exporters/sqs.d.ts",
      "default": "./src/exporters/sqs.js"
    },
    "./firehose": {
      "types": "./src/exporters/firehose.d.ts",
      "default": "./src/exporters/firehose.js"
    },
    "./eventbridge": {
      "types": "./src/exporters/eventbridge.d.ts",
      "default": "./src/exporters/eventbridge.js"
    },
    "./redshift": {
      "types": "./src/exporters/redshift.d.ts",
      "default": "./src/exporters/redshift.js"
    },
    "./lambda-log": {
      "types": "./src/exporters/lambda-log.d.ts",
      "default": "./src/exporters/lambda-log.js"
    },
    "./http": {
      "types": "./src/exporters/http.d.ts",
      "default": "./src/exporters/http.js"
    },
    "./file": {
      "types": "./src/exporters/file.d.ts",
      "default": "./src/exporters/file.js"
    }
  },
  "files": [
    "src/",
    "README.md"
  ],
  "scripts": {
    "test": "node --test \"test/**/*.test.js\""
  }
}
