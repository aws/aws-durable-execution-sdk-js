{
  "name": "@aws/durable-execution-sdk-js-extras",
  "description": "Custom durable operations for the AWS Durable Execution SDK, such as running a job in an AWS Lambda MicroVM or in Amazon Bedrock AgentCore Runtime",
  "version": "0.1.0-alpha.0",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/aws/aws-durable-execution-sdk-js.git",
    "directory": "packages/aws-durable-execution-sdk-js-extras"
  },
  "homepage": "https://github.com/aws/aws-durable-execution-sdk-js/tree/main/packages/aws-durable-execution-sdk-js-extras",
  "engines": {
    "node": ">=22"
  },
  "main": "./dist-cjs/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist-types/index.d.ts",
  "scripts": {
    "clean": "rm -rf dist dist-cjs dist-types node_modules coverage .tsbuildinfo .rollup.cache",
    "build": "concurrently npm:build:esm npm:build:cjs npm:build:types",
    "build:esm": "rollup --config rollup.config.mjs --environment MODE:esm",
    "build:cjs": "rollup --config rollup.config.mjs --environment MODE:cjs",
    "build:types": "tsc --project tsconfig.build.json --outDir dist-types",
    "prepublishOnly": "npm run build && npm run test",
    "lint": "biome check src --diagnostic-level=error",
    "lint:fix": "biome check --write src",
    "prebuild": "rm -rf dist dist-cjs dist-types",
    "pretest": "npm run build --workspace=@aws/durable-execution-sdk-js-compute-worker",
    "test": "tsc --noEmit && vitest run --coverage"
  },
  "exports": {
    ".": {
      "types": "./dist-types/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist-cjs/index.js"
    },
    "./compute/microvm": {
      "types": "./dist-types/compute/microvm/index.d.ts",
      "import": "./dist/compute/microvm.mjs",
      "require": "./dist-cjs/compute/microvm.js"
    },
    "./compute/agentcore": {
      "types": "./dist-types/compute/agentcore/index.d.ts",
      "import": "./dist/compute/agentcore.mjs",
      "require": "./dist-cjs/compute/agentcore.js"
    }
  },
  "files": [
    "dist/",
    "dist-cjs/",
    "dist-types"
  ],
  "devDependencies": {
    "@aws-sdk/client-bedrock-agentcore": "^3.1164.0",
    "@aws-sdk/client-lambda-microvms": "^3.1164.0",
    "@aws/durable-execution-sdk-js-compute-worker": "0.1.0-alpha.0",
    "@aws/durable-execution-sdk-js-testing": "*",
    "@biomejs/biome": "2.5.15",
    "@vitest/coverage-v8": "^5.1.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^5.1.0"
  },
  "peerDependencies": {
    "@aws/durable-execution-sdk-js": ">=2.6.0",
    "@aws-sdk/client-bedrock-agentcore": "^3.1164.0",
    "@aws-sdk/client-lambda-microvms": "^3.1164.0"
  },
  "peerDependenciesMeta": {
    "@aws-sdk/client-bedrock-agentcore": {
      "optional": true
    },
    "@aws-sdk/client-lambda-microvms": {
      "optional": true
    }
  },
  "private": false
}
