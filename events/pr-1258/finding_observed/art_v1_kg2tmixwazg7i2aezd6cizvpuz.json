{"data":{"body":"[P3] Exclude empty subtypes from the rejection claim\n\n`subType: \"\"` selects the SDK's default subtype, and `valid-operation-identifiers.test.ts` explicitly lists it as valid. This wording incorrectly tells upgrading users that this working configuration fails lint and execution. Qualify the restriction as applying to nonempty subtype values.","comment_node_id":"PRRC_kwDOPenXVs8AAAABE38u_A","finding_digest":"77101ebc803b9c52abdbf7b49704da8ffd2af1042475e90bf4ede60d2c55bcf1","finding_id":"arf_v1_o4ib5peahooffk63662jobg2r7","finding_key":"changelog.md::valid-operation-identifiers::empty-subtype-default","identity_key":"changelog.md::valid-operation-identifiers::empty-subtype-default","line":79,"observation_digest":"85b4ee57f3ddb0b1cfc9f77b2ab7ff86a5d7626982e9dcab5a26dd08d307166a","observation_id":"aro_v1_qw2o4v7t3wyldt6j655svn77q2","path":"CHANGELOG.md","prior_finding_id":"","published_at":"2026-11-18T23:04:21Z","review_id":"arr_v1_gousmpjuh6khplk2kv7gilsp6t","reviewed_base_sha":"a4675206e2c40186cd6ec8c07353c3daa4a74f2b","reviewed_head_sha":"9c0f5acd534bd09513522b242785ad24ef137e52","reviewer":"codex","start_line":79,"suggestion_id":"arsg_v1_rrznbam5qwmunskpw3al3oivo4"},"pull_request":{"number":1258},"record_id":"art_v1_kg2tmixwazg7i2aezd6cizvpuz","record_type":"finding_observed","recorded_at":"2026-11-18T23:04:21Z","repository":{"full_name":"aws/aws-durable-execution-sdk-js","id":1038735190},"schema_version":1}
