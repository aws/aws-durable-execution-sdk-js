{"data":{"body":"[P3] Allow subsequent valid release versions\n\nBumping either package to `1.0.1`, with a matching lockfile, will fail this assertion. The documented release process updates package versions, and `npm-publish.yml` runs the full test suite before publishing, so every subsequent telemetry release now requires editing this test too. Validate the version against an appropriate range, such as `>=1.0.0`, while retaining the manifest/lockfile equality check.","comment_node_id":"PRRC_kwDOPenXVs8AAAABA1kqlQ","finding_digest":"7674af616a36392cfd7329a1d04bd8da69b2d87bcfcd41689f569249fd50545d","finding_id":"arf_v1_oz2k6ylkgy4sz7ltfgq5as6y3j","finding_key":"telemetry-mcp::telemetry-release-versions::version-bump-compatibility","identity_key":"telemetry-mcp::telemetry-release-versions::version-bump-compatibility","line":62,"observation_digest":"f506e153f80fe21be53c62dcc597446c8dbec7fa6d1c6e58da36dcdb01864f63","observation_id":"aro_v1_6udocu7yb7rbxzj4mlomlf2ens","path":"packages/aws-durable-execution-sdk-js-telemetry-mcp/src/packaging.test.ts","prior_finding_id":"","published_at":"2026-10-22T16:57:47Z","review_id":"arr_v1_np2wyyhepak76uwke75jhvqggt","reviewed_base_sha":"5b76ab44dc34eeda0c97c3b39a26660cdbbc169f","reviewed_head_sha":"dcabff529e1dd279b3be37a7575ebe78d144e0b3","reviewer":"codex","start_line":62,"suggestion_id":""},"pull_request":{"number":1030},"record_id":"art_v1_boaudckfonxmrrqvutuwdidilg","record_type":"finding_observed","recorded_at":"2026-10-22T16:57:47Z","repository":{"full_name":"aws/aws-durable-execution-sdk-js","id":1038735190},"schema_version":1}
