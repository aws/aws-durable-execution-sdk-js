{"data":{"body":"[P2] Bound the native timer delay\n\nA valid wait such as `{ days: 30 }` passes more than `2 ** 31 - 1` milliseconds to `realSetTimeout` while its invocation runs. Node replaces that delay with 1 ms and emits `TimeoutOverflowWarning`. The callback then schedules the same oversized delay repeatedly, producing a rapid warning loop for as long as a sibling step keeps the invocation active. Clamp the timer delay and recheck the deadline when it fires; cover oversized waits and retry delays in an active invocation.","comment_node_id":"PRRC_kwDOPenXVs7_v9fH","finding_digest":"1915e3192226059f36f5bbbdcc193c03cd0aad9d5a67ade78862414c8d67cfdd","finding_id":"arf_v1_dek6ggjceycz6nxvxo64ygj4ap","finding_key":"packages/aws-durable-execution-sdk-js-testing/src/test-runner/local/test-execution-orchestrator.ts::releasetimedcompletions::native-timer-delay-bound","identity_key":"packages/aws-durable-execution-sdk-js-testing/src/test-runner/local/test-execution-orchestrator.ts::releasetimedcompletions::native-timer-delay-bound","line":809,"observation_digest":"419cf5d587fd93b79255b5087943a857dab377806c9403786d450d342032be4e","observation_id":"aro_v1_igoplvmh7wj3pesvwuehsq5ik7","path":"packages/aws-durable-execution-sdk-js-testing/src/test-runner/local/test-execution-orchestrator.ts","prior_finding_id":"","published_at":"2026-10-16T03:53:34Z","review_id":"arr_v1_mwos3ugwezi2emge6nz65zumig","reviewed_base_sha":"911b7f0eee6d6322d47a0b4716b758555d404b15","reviewed_head_sha":"1e5ec7610c01d7b19c49d1e359eaea16a185225c","reviewer":"codex","start_line":809,"suggestion_id":"arsg_v1_5vuslg4j5m4b57zyqq2bjds7mz"},"pull_request":{"number":1012},"record_id":"art_v1_uz7gnfgiac3iqgbxmn5jlxd77h","record_type":"finding_observed","recorded_at":"2026-10-16T03:53:34Z","repository":{"full_name":"aws/aws-durable-execution-sdk-js","id":1038735190},"schema_version":1}
