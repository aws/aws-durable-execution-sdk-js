{"data":{"body":"[P1] Resolve release branches with fully qualified refs. With `fetch-depth: 0`, checkout fetches all tags too. A tag named `origin/main` pointing at an off-branch release commit takes precedence over `refs/remotes/origin/main` when Git resolves this argument. The ancestry check therefore succeeds even though neither allowed branch contains the release commit. Use `refs/remotes/origin/$branch` explicitly and add a regression test covering a colliding tag.","comment_node_id":"PRRC_kwDOPenXVs8AAAABEE-o_A","finding_digest":"08c241f4a05a4412927dc80b9c4038bf426e0c272ef67f225ddda39cd8bb6cb7","finding_id":"arf_v1_bdbed5faljcbfet5zafzyqbyx5","finding_key":"github/workflows/npm-publish.yml::release-branch-check::tag-shadowed-branch-ref","identity_key":"github/workflows/npm-publish.yml::release-branch-check::tag-shadowed-branch-ref","line":42,"observation_digest":"511edecf9a8c1d8fea248c6f954ae93a70c5d09cbbf6b3887c9a78c22d11db18","observation_id":"aro_v1_kepn5t42rqoy72rerrxzksxjhj","path":".github/workflows/npm-publish.yml","prior_finding_id":"","published_at":"2026-11-13T21:01:51Z","review_id":"arr_v1_ksm2clpavkagoqdsevtnatr3cn","reviewed_base_sha":"8f14f32613a87670fe36f2fac73f5de23eb43930","reviewed_head_sha":"26183ad3ca26474cc8cae936fc2d9754336c2ae1","reviewer":"codex","start_line":42,"suggestion_id":"arsg_v1_r3btqwglvqqnepaqyxodijit4k"},"pull_request":{"number":1226},"record_id":"art_v1_ea7aedc6wt2rbs2rojpgf5kexy","record_type":"finding_observed","recorded_at":"2026-11-13T21:01:51Z","repository":{"full_name":"aws/aws-durable-execution-sdk-js","id":1038735190},"schema_version":1}
