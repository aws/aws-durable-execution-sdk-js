{"data":{"body":"The existing composed test\u2019s fake service sends its `resume` hook with empty headers. This new gate therefore ignores that hook, and the test succeeds only through the 30-second fallback, so a broken cross-package resume path could pass CI. Update the fake service to send Lambda-like headers such as `host: \"localhost:8080\"`, and assert delivery completes before the fallback.","comment_node_id":"PRRC_kwDOPenXVs768Wtz","finding_digest":"5bad1c354c391ac9957f89c2fb0fdee268ba74d2c92a7feb11fcaf6ee7884526","finding_id":"arf_v1_lowrynkmhenmtfl7rhbpwd664j","finding_key":"packages/aws-durable-execution-sdk-js-microvm-worker/src/worker.ts::create-microvm-worker-listener::resume-composed-hook-origin","identity_key":"packages/aws-durable-execution-sdk-js-microvm-worker/src/worker.ts::create-microvm-worker-listener::resume-composed-hook-origin","line":697,"observation_digest":"f6cf79946f55588755767113714df9e4c01092e46e96568ed3a8d650cadbb612","observation_id":"aro_v1_63hxtfdpkvmiovlwoejxctpz4t","path":"packages/aws-durable-execution-sdk-js-microvm-worker/src/worker.ts","prior_finding_id":"","published_at":"2026-10-07T17:48:47Z","review_id":"arr_v1_lhc5gfpfustzdugimfyvhkto7b","reviewed_base_sha":"503e7371a6bad9d7d92f42742573cc409b755109","reviewed_head_sha":"e1525ea906965040ed574fcfb7fa0b7cb0df2474","reviewer":"codex","start_line":697,"suggestion_id":""},"pull_request":{"number":975},"record_id":"art_v1_u2irdbgro2z4jus5l5slwdv5sh","record_type":"finding_observed","recorded_at":"2026-10-07T17:48:47Z","repository":{"full_name":"aws/aws-durable-execution-sdk-js","id":1038735190},"schema_version":1}
