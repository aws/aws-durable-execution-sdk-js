{"data":{"body":"[P2] Preserve terminal exports with supported core 2.4\u20132.6. Those versions satisfy the package's peer range but provide neither `updatedOperations` nor `onOperationChange`, so a deferred external completion reaches this branch as replayed with no pending entry and its only terminal span is dropped. Either require core 2.7+ or detect unavailable completion metadata and retain legacy export behavior; add an installed-2.6 deferred-completion regression test.","comment_node_id":"PRRC_kwDOPenXVs77s826","finding_digest":"6202977ae383832f70e3d759ea541def0401a09ed2327e5da8de81a4a98272ae","finding_id":"arf_v1_mibjo6xdqobs64hd25m6uva554","finding_key":"packages/aws-durable-execution-sdk-js-otel/src/execution-plugin.ts::executionotelplugin.onoperationend::legacy-core-replay-completion-loss","identity_key":"packages/aws-durable-execution-sdk-js-otel/src/execution-plugin.ts::executionotelplugin.onoperationend::legacy-core-replay-completion-loss","line":576,"observation_digest":"b9bbf56e513c4859044825dae34445bcb8173602bc36d770c993f5b099fd73ef","observation_id":"aro_v1_xg57k3srhrefsbciexnogrcfxs","path":"packages/aws-durable-execution-sdk-js-otel/src/execution-plugin.ts","prior_finding_id":"arf_v1_mibjo6xdqobs64hd25m6uva554","published_at":"2026-10-08T18:45:49Z","review_id":"arr_v1_45jz2py5hb55jcf7ehxkgxe4rs","reviewed_base_sha":"cc7da9aaa2da8fdc6fc9b0d31c7b74ff1c2eb382","reviewed_head_sha":"8fa5639fa1f3f3e9e162618f2e975ee01d4f9de9","reviewer":"codex","start_line":575,"suggestion_id":""},"pull_request":{"number":953},"record_id":"art_v1_rkphu4tacvyrj6g6bkm57to3u3","record_type":"finding_observed","recorded_at":"2026-10-08T18:45:49Z","repository":{"full_name":"aws/aws-durable-execution-sdk-js","id":1038735190},"schema_version":1}
