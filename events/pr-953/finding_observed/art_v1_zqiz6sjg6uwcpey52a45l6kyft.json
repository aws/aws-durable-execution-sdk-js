{"data":{"body":"[P2] This skip rule depends on core 2.7 populating `updatedOperations` or emitting `onOperationChange`, while the package still declares core 2.4\u20132.6 compatible. On those versions `pending` is never populated, so the first replay-delivered external completion is mistaken for ordinary replay and its terminal span is dropped. Raise the core peer floor, or detect the legacy hook contract and retain a fallback export path; add an installed-core-2.6 resume regression test.","comment_node_id":"PRRC_kwDOPenXVs7-LLBv","finding_digest":"6202977ae383832f70e3d759ea541def0401a09ed2327e5da8de81a4a98272ae","finding_id":"arf_v1_mibjo6xdqobs64hd25m6uva554","finding_key":"packages/aws-durable-execution-sdk-js-otel/src/execution-plugin.ts::executionotelplugin.onoperationend::legacy-core-replay-completion-loss","identity_key":"packages/aws-durable-execution-sdk-js-otel/src/execution-plugin.ts::executionotelplugin.onoperationend::legacy-core-replay-completion-loss","line":608,"observation_digest":"46a841992cc9734b4b36aaff26486f7e7cf5168f6cd79bc8bc16077f9d08bfb3","observation_id":"aro_v1_i2uedgjmzfzuwszwvl7smsdppz","path":"packages/aws-durable-execution-sdk-js-otel/src/execution-plugin.ts","prior_finding_id":"arf_v1_mibjo6xdqobs64hd25m6uva554","published_at":"2026-10-13T21:42:51Z","review_id":"arr_v1_5ghvffb5cimms3nptufn2s3ir6","reviewed_base_sha":"5c28654e7911475c2f20e6b21ba0d28ce1dac664","reviewed_head_sha":"c45d4eda09dd456b3b4a6e8f0a056ef97673c002","reviewer":"codex","start_line":607,"suggestion_id":""},"pull_request":{"number":953},"record_id":"art_v1_zqiz6sjg6uwcpey52a45l6kyft","record_type":"finding_observed","recorded_at":"2026-10-13T21:42:51Z","repository":{"full_name":"aws/aws-durable-execution-sdk-js","id":1038735190},"schema_version":1}
