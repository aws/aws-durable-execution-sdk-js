{"data":{"body":"[P1] The fake `node` reports major 22 by default, so this invocation takes the installed-Node fast path and never calls the fake `uname`. It consequently succeeds and makes the self-test fail on every conformance run. Force a non-22 major here so the unsupported-platform branch is exercised.","comment_node_id":"PRRC_kwDOPenXVs76fXjf","finding_digest":"cc0c63872b773b09eabd9befdad0f53d74ed3d82c12c26dc8cc5ba24c025ba47","finding_id":"arf_v1_zqgghbzlo45qt2v5tpx5vuhvhv","finding_key":"github/workflows/scripts/setup-node22.test.sh::unsupported-platform-fixture::download-path-not-reached","identity_key":"github/workflows/scripts/setup-node22.test.sh::unsupported-platform-fixture::download-path-not-reached","line":56,"observation_digest":"e62daa0698323aeac1a6925001d7a19385e1a5b051f9088b79ed2f62832fc423","observation_id":"aro_v1_4yw2ubuygi5ovqngsjiadv5bso","path":".github/workflows/scripts/setup-node22.test.sh","prior_finding_id":"","published_at":"2026-10-07T02:45:37Z","review_id":"arr_v1_6mqve7ia34p7qs6mpu7zdjuzck","reviewed_base_sha":"7de88e9c9ef4a9bb0c13a5cae7b6270119276e60","reviewed_head_sha":"8a3620775e58f24b6e4e23c887b7b71677677230","reviewer":"codex","start_line":56,"suggestion_id":"arsg_v1_tgcbuvlisa3sbnqwzvz2qdqbkd"},"pull_request":{"number":953},"record_id":"art_v1_ql6cpmy5rlihmcgnszezgc6dcp","record_type":"finding_observed","recorded_at":"2026-10-07T02:45:37Z","repository":{"full_name":"aws/aws-durable-execution-sdk-js","id":1038735190},"schema_version":1}
