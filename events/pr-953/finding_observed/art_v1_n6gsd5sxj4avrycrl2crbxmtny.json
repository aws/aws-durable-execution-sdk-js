{"data":{"body":"[P2] This deduplication requires core 2.7's `updatedOperations`/`onOperationChange` contract, but the package still supports core 2.4\u20132.6. Those versions never add the newly completed operation to `pending`, so its replay-marked terminal hook is skipped and both views lose the completion span. Raise the core peer floor to 2.7, or retain a legacy export path when the update contract is absent; add an installed-core-2.6 resume regression test.","comment_node_id":"PRRC_kwDOPenXVs7-IgJx","finding_digest":"6202977ae383832f70e3d759ea541def0401a09ed2327e5da8de81a4a98272ae","finding_id":"arf_v1_mibjo6xdqobs64hd25m6uva554","finding_key":"packages/aws-durable-execution-sdk-js-otel/src/execution-plugin.ts::executionotelplugin.onoperationend::legacy-core-replay-completion-loss","identity_key":"packages/aws-durable-execution-sdk-js-otel/src/execution-plugin.ts::executionotelplugin.onoperationend::legacy-core-replay-completion-loss","line":607,"observation_digest":"4a39d9c3fc7d9a941fce48206a27f40cb2ce56da1a896177b2133f7f22fbaf73","observation_id":"aro_v1_ji45tq74pwnjih6ojaqguj7ubs","path":"packages/aws-durable-execution-sdk-js-otel/src/execution-plugin.ts","prior_finding_id":"arf_v1_mibjo6xdqobs64hd25m6uva554","published_at":"2026-10-13T20:25:46Z","review_id":"arr_v1_iptzduoghdf5u7n2klczksit43","reviewed_base_sha":"96e77ccadbc193e0f624d2ae1acee45b56c38313","reviewed_head_sha":"faa4c361a29658517efa8a1e1597f74583f295c7","reviewer":"codex","start_line":607,"suggestion_id":""},"pull_request":{"number":953},"record_id":"art_v1_n6gsd5sxj4avrycrl2crbxmtny","record_type":"finding_observed","recorded_at":"2026-10-13T20:25:46Z","repository":{"full_name":"aws/aws-durable-execution-sdk-js","id":1038735190},"schema_version":1}
