{"data":{"body":"[P2] This deduplication relies on core 2.7's `updatedOperations`/`onOperationChange`, but the package still accepts core 2.4\u20132.6. Those versions never populate the pending set, so a newly completed external operation surfaced with `isReplay: true` is skipped, losing its terminal span. Raise the core peer floor to 2.7, or detect the legacy contract and export replayed external completions; add an installed-core-2.6 regression test.","comment_node_id":"PRRC_kwDOPenXVs7-ELjC","finding_digest":"6202977ae383832f70e3d759ea541def0401a09ed2327e5da8de81a4a98272ae","finding_id":"arf_v1_mibjo6xdqobs64hd25m6uva554","finding_key":"packages/aws-durable-execution-sdk-js-otel/src/execution-plugin.ts::executionotelplugin.onoperationend::legacy-core-replay-completion-loss","identity_key":"packages/aws-durable-execution-sdk-js-otel/src/execution-plugin.ts::executionotelplugin.onoperationend::legacy-core-replay-completion-loss","line":607,"observation_digest":"45a9d92541583de98a6b2723e7f2d27ccf511bc199d04194a25a37ab2eaffa97","observation_id":"aro_v1_iwu5sjkbla66tctle4r6p4wspt","path":"packages/aws-durable-execution-sdk-js-otel/src/execution-plugin.ts","prior_finding_id":"arf_v1_mibjo6xdqobs64hd25m6uva554","published_at":"2026-10-13T18:31:25Z","review_id":"arr_v1_isu2wgsu37vkifogd3gmzrctud","reviewed_base_sha":"89011d8369d00ba0f6ddb49d850f73d1e864d96d","reviewed_head_sha":"94f76a99dd991c914d7626f7ab49ec2832167ec5","reviewer":"codex","start_line":607,"suggestion_id":""},"pull_request":{"number":953},"record_id":"art_v1_3ybi5fg3cja4c3vfhfq5hyqyr7","record_type":"finding_observed","recorded_at":"2026-10-13T18:31:25Z","repository":{"full_name":"aws/aws-durable-execution-sdk-js","id":1038735190},"schema_version":1}
