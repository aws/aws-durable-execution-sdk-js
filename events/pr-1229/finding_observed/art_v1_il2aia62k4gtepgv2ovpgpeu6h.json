{"data":{"body":"[P2] Add the required Unreleased changelog entry\n\nThis changes default retry behavior and removes four public exports, but the diff contains no CHANGELOG.md update. Root AGENTS.md's pull-request rule 3 requires an Unreleased entry for breaking changes; experimental APIs are not exempt. Add an entry identifying the removed exports and the validation, retry and deadline changes so upgrading users can identify the migration impact.","comment_node_id":"PRRC_kwDOPenXVs8AAAABEbK6Ag","finding_digest":"bdd98f3d734c525e92b86e55bbeee9ec78add63b22159f04fbe61389aa49125a","finding_id":"arf_v1_xxmy6pltjrjf5evynzk3x3xj5r","finding_key":"packages/aws-durable-execution-sdk-js-extras/src/ai::public-api::missing-breaking-change-changelog","identity_key":"packages/aws-durable-execution-sdk-js-extras/src/ai::public-api::missing-breaking-change-changelog","line":147,"observation_digest":"17fef68e56bf4f403ee79979b1bba0df73c79198cd7555a8ffda6a649fa0c29b","observation_id":"aro_v1_c77pndswx5huapxhtf43do5a35","path":"packages/aws-durable-execution-sdk-js-extras/docs/ai.md","prior_finding_id":"","published_at":"2026-11-16T21:33:37Z","review_id":"arr_v1_o5rweboqfhtbzvactc7khitsqn","reviewed_base_sha":"2057d89efe636584203e7b97ee0b87b0b71ecaea","reviewed_head_sha":"949b3e980ffe6ed2bcea732a149fc7e4c1eb0ddd","reviewer":"codex","start_line":147,"suggestion_id":""},"pull_request":{"number":1229},"record_id":"art_v1_il2aia62k4gtepgv2ovpgpeu6h","record_type":"finding_observed","recorded_at":"2026-11-16T21:33:37Z","repository":{"full_name":"aws/aws-durable-execution-sdk-js","id":1038735190},"schema_version":1}
