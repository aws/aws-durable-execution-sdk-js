{"data":{"body":"[P2] Preserve CI coverage for supported ESLint majors\n\nAfter this upgrade, both the RuleTester suites and examples smoke test resolve ESLint 10; previously they exercised ESLint 8 and 9 respectively. Since `peerDependencies` still advertises `eslint >=8.0.0`, compatibility regressions for ESLint 8/9 can now ship unnoticed. Add an ESLint 8/9/10 CI matrix, including a plugin smoke test, or narrow the peer range to tested versions.","comment_node_id":"PRRC_kwDOPenXVs7-EP5b","finding_digest":"de9344514f73e16859f1b732ee3aff05b7697ae44e3905597d81c79dd5e102ec","finding_id":"arf_v1_32juiukpopqwqwprw4zo4ox7aw","finding_key":"packages/aws-durable-execution-sdk-js-eslint-plugin/package.json::eslint-dev-dependency::supported-major-test-coverage","identity_key":"packages/aws-durable-execution-sdk-js-eslint-plugin/package.json::eslint-dev-dependency::supported-major-test-coverage","line":38,"observation_digest":"444027c1e3bd72b015c901d6575006d2fa8eab478f0af70008d71923ca6e620f","observation_id":"aro_v1_iracpqpdxvzlafojahlfouag2l","path":"packages/aws-durable-execution-sdk-js-eslint-plugin/package.json","prior_finding_id":"","published_at":"2026-10-13T18:33:13Z","review_id":"arr_v1_vwk76clpzivvkyrsw7lnqmmy3e","reviewed_base_sha":"89011d8369d00ba0f6ddb49d850f73d1e864d96d","reviewed_head_sha":"9b6653a3c8c02dea4aab705e152dc37f06e7ffa4","reviewer":"codex","start_line":38,"suggestion_id":""},"pull_request":{"number":993},"record_id":"art_v1_p55tbgyi3vjhuleemviuxmwidu","record_type":"finding_observed","recorded_at":"2026-10-13T18:33:13Z","repository":{"full_name":"aws/aws-durable-execution-sdk-js","id":1038735190},"schema_version":1}
