{"data":{"body":"[P2] Add composed coverage for grouped dispatch. The dispatcher test invokes a stub handler, and the runner test stops at a mocked Invoke call. Local example tests bypass the dispatcher, leaving payload/context forwarding and replay restoration dependent on cloud tests. CONTRIBUTING requires composed tests when a change spans internal components. Add a composed regression using the runner\u2019s envelope and a real durable handler, verifying example selection, original payload and context forwarding, then suspension and replay through this handler.","comment_node_id":"","finding_digest":"a620d1531bcf394db0b64d6f6e2130be35b23ed3ae3ab2a03b5db5428a4db2e4","finding_id":"arf_v1_uyqncuy3z44u3mfwjvxw4ijqxy","finding_key":"packages/aws-durable-execution-sdk-js-examples/scripts/integration-dispatch.cjs::handler::missing-composed-replay-coverage","identity_key":"packages/aws-durable-execution-sdk-js-examples/scripts/integration-dispatch.cjs::handler::missing-composed-replay-coverage","line":89,"observation_digest":"5bb902b9ba94c0b8183c3a1193c050fcb949d7ef1116a6a9843c1b292dc5eb0b","observation_id":"aro_v1_lo4qfon2stalqgb4hiizhqcq7s","path":"packages/aws-durable-execution-sdk-js-examples/scripts/integration-dispatch.cjs","prior_finding_id":"arf_v1_uyqncuy3z44u3mfwjvxw4ijqxy","published_at":"2026-11-26T01:00:07Z","review_id":"arr_v1_eg2nzghi3xtxfbn33tyyaskz3r","reviewed_base_sha":"49ed7a672da58fde80e2ef960748d8399a5587c1","reviewed_head_sha":"310d08b5e395f900aadda30e95e184e8b8b26762","reviewer":"codex","start_line":89,"suggestion_id":"","suppressed":true,"suppression_status":"false-positive"},"pull_request":{"number":1292},"record_id":"art_v1_v23bqpnzygjquagtlnwe4ukfxo","record_type":"finding_observed","recorded_at":"2026-11-26T01:00:07Z","repository":{"full_name":"aws/aws-durable-execution-sdk-js","id":1038735190},"schema_version":1}
