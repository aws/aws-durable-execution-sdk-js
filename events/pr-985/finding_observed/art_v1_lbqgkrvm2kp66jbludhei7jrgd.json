{"data":{"body":"**P2 \u2014 Exercise Electron 44 in CI.** CI skips the Electron binary download, desktop tests mock Electron, and the host job only bundles with esbuild. Consequently, startup, sandbox/custom-protocol, or packaging regressions across the Electron 32\u219244 upgrade can merge unnoticed. Add a PR-gated Electron startup smoke test and an `electron-builder --dir` package check for at least one supported target.","comment_node_id":"PRRC_kwDOPenXVs78tRDH","finding_digest":"189b17eba5d4540476c1071343d2eb05ac970c0f6b7c10a759cd5d379db58265","finding_id":"arf_v1_dcnrp25f2rkai5wba4juhuxlaw","finding_key":"insight-desktop::electron-upgrade::runtime-packaging-smoke-coverage","identity_key":"insight-desktop::electron-upgrade::runtime-packaging-smoke-coverage","line":31,"observation_digest":"ede521f47176f6196f9b3f15cfd8e1b68f1493a70b66bbd3d74512e85d01fcce","observation_id":"aro_v1_5xssd5dro33bs343h4k47whbw2","path":"packages/aws-durable-execution-sdk-js-insight-desktop/package.json","prior_finding_id":"arf_v1_dcnrp25f2rkai5wba4juhuxlaw","published_at":"2026-10-11T00:31:09Z","review_id":"arr_v1_6nljad6oyh3fhwulq24tttbkhj","reviewed_base_sha":"25e0eaf8af1930e48e698eec3382c42ca37649c7","reviewed_head_sha":"b84ded7830e64b83b4e114064f6009950cdccfbb","reviewer":"codex","start_line":31,"suggestion_id":""},"pull_request":{"number":985},"record_id":"art_v1_lbqgkrvm2kp66jbludhei7jrgd","record_type":"finding_observed","recorded_at":"2026-10-11T00:31:09Z","repository":{"full_name":"aws/aws-durable-execution-sdk-js","id":1038735190},"schema_version":1}
