{"data":{"body":"**P2 \u2014 Raise the source-build floor to Node 22.12.** This range accepts Node 22.0\u201322.11, but the updated lockfile resolves `yargs@18.2.0` and `yargs-parser@22`, which require `^22.12.0`; `npm ci` can therefore fail with `engine-strict` for versions claimed as supported. Declare `>=22.12.0` here and in `TESTING.md`, or retain a Vega-Lite dependency stack compatible with the full range.","comment_node_id":"PRRC_kwDOPenXVs78tNrM","finding_digest":"ba0a43eb79b431c7841428d5a906a7c7dc5914fbecffed9188071da2a480e6ce","finding_id":"arf_v1_xifeh23zwqy4pbaufdk2sbvhy7","finding_key":"insight-vscode/webview-ui::engines::yargs-node-floor-mismatch","identity_key":"insight-vscode/webview-ui::engines::yargs-node-floor-mismatch","line":6,"observation_digest":"fb40997d3993e41f18fb09071de6959b6be6a1e9e82d13b0969a71a5b0dc892b","observation_id":"aro_v1_7najs7jzspsb6gh3bedr3zuvtn","path":"packages/aws-durable-execution-sdk-js-insight-vscode/webview-ui/package.json","prior_finding_id":"","published_at":"2026-10-11T00:25:09Z","review_id":"arr_v1_aeyrlw7qx6xyahtk5n4fhosfnb","reviewed_base_sha":"25e0eaf8af1930e48e698eec3382c42ca37649c7","reviewed_head_sha":"964d9b2f062c3090027beda2eb721171c02181d4","reviewer":"codex","start_line":6,"suggestion_id":""},"pull_request":{"number":985},"record_id":"art_v1_kyl3t6sehixoctmnmt7u7r5gzs","record_type":"finding_observed","recorded_at":"2026-10-11T00:25:09Z","repository":{"full_name":"aws/aws-durable-execution-sdk-js","id":1038735190},"schema_version":1}
