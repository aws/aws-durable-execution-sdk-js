{"data":{"body":"`vega-lite@6.5.0` requires Node >=22, but this extension still supports and documents Node >=20. Node 20 source installs now fail when `engine-strict` is enabled. Keep Vega-Lite on a pinned/tilde 6.4.x range and refresh the lockfile, or raise the documented development requirement and CI coverage to Node 22.","comment_node_id":"PRRC_kwDOPenXVs78tF_c","finding_digest":"55262d1741a13e71e062d35e638a0ae996c7841679947a21d490d8f54384fbaa","finding_id":"arf_v1_kutc2f2bue7hdydc2npghcqk5g","finding_key":"insight-vscode/webview-ui::vega-lite::node20-engine-compatibility","identity_key":"insight-vscode/webview-ui::vega-lite::node20-engine-compatibility","line":18,"observation_digest":"20606cd5650e911f719178288efde0af99aa4aa8721f399291b8311540e69419","observation_id":"aro_v1_ebqgzvlfb2ir64mrpaui57pav6","path":"packages/aws-durable-execution-sdk-js-insight-vscode/webview-ui/package.json","prior_finding_id":"arf_v1_kutc2f2bue7hdydc2npghcqk5g","published_at":"2026-10-11T00:11:42Z","review_id":"arr_v1_6rczs2ifpzuycvt53w22n7sf2z","reviewed_base_sha":"25e0eaf8af1930e48e698eec3382c42ca37649c7","reviewed_head_sha":"4cc7b2eb763b17b2d82dadccee71426b621cd168","reviewer":"codex","start_line":18,"suggestion_id":""},"pull_request":{"number":985},"record_id":"art_v1_lvuahawcnpwzwkdki22njft6vg","record_type":"finding_observed","recorded_at":"2026-10-11T00:11:42Z","repository":{"full_name":"aws/aws-durable-execution-sdk-js","id":1038735190},"schema_version":1}
