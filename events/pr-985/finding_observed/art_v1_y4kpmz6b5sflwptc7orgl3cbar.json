{"data":{"body":"`vega-lite@6.5.0` requires Node >=22, but this extension still supports and documents Node >=20. Node 20 source installs are now outside the dependency's supported range and fail when `engine-strict` is enabled. Keep Vega-Lite on a pinned/tilde 6.4.x range and refresh the lockfile, or raise the documented development requirement and CI coverage to Node 22.","comment_node_id":"PRRC_kwDOPenXVs78tCIk","finding_digest":"55262d1741a13e71e062d35e638a0ae996c7841679947a21d490d8f54384fbaa","finding_id":"arf_v1_kutc2f2bue7hdydc2npghcqk5g","finding_key":"insight-vscode/webview-ui::vega-lite::node20-engine-compatibility","identity_key":"insight-vscode/webview-ui::vega-lite::node20-engine-compatibility","line":18,"observation_digest":"09be828c8502a7e80910144f1345929e5fc4caa6b18b0f4b05096f9d2947e978","observation_id":"aro_v1_bg7ifdefakt6qciqcrhrgrmstz","path":"packages/aws-durable-execution-sdk-js-insight-vscode/webview-ui/package.json","prior_finding_id":"","published_at":"2026-10-11T00:04:46Z","review_id":"arr_v1_4ndl6364omfiuiy73jx4svsk43","reviewed_base_sha":"25e0eaf8af1930e48e698eec3382c42ca37649c7","reviewed_head_sha":"004b20824aac3fc3e845d6b14a6ecb7a4de86ba4","reviewer":"codex","start_line":18,"suggestion_id":""},"pull_request":{"number":985},"record_id":"art_v1_y4kpmz6b5sflwptc7orgl3cbar","record_type":"finding_observed","recorded_at":"2026-10-11T00:04:46Z","repository":{"full_name":"aws/aws-durable-execution-sdk-js","id":1038735190},"schema_version":1}
