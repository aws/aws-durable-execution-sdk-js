{"data":{"body":"**P2 \u2014 The documented Node 20 source build remains broken.** `vega-lite@6.5.0` requires Node >=22, while `TESTING.md` still specifies Node >=20 and the README installs this nested package separately. Node 20 installs therefore warn or fail with `engine-strict`. Update the documentation and add an explicit webview `engines.node >=22`, or retain Vega-Lite 6.4.x.","comment_node_id":"PRRC_kwDOPenXVs78tJuR","finding_digest":"55262d1741a13e71e062d35e638a0ae996c7841679947a21d490d8f54384fbaa","finding_id":"arf_v1_kutc2f2bue7hdydc2npghcqk5g","finding_key":"insight-vscode/webview-ui::vega-lite::node20-engine-compatibility","identity_key":"insight-vscode/webview-ui::vega-lite::node20-engine-compatibility","line":18,"observation_digest":"2d24977268e0afd9d7e83b451bc74bd90897173260dd2c69a768db206106bb2a","observation_id":"aro_v1_fusjo4ti4cx5tv7ihncrxr2l3e","path":"packages/aws-durable-execution-sdk-js-insight-vscode/webview-ui/package.json","prior_finding_id":"arf_v1_kutc2f2bue7hdydc2npghcqk5g","published_at":"2026-10-11T00:18:23Z","review_id":"arr_v1_by46yjsmgkp5wc5e2k67q46g6b","reviewed_base_sha":"25e0eaf8af1930e48e698eec3382c42ca37649c7","reviewed_head_sha":"e67178851fc68587699919de5524c9ac02224bc5","reviewer":"codex","start_line":18,"suggestion_id":""},"pull_request":{"number":985},"record_id":"art_v1_6nso6xdox4c3u65e6kb6mkxjim","record_type":"finding_observed","recorded_at":"2026-10-11T00:18:23Z","repository":{"full_name":"aws/aws-durable-execution-sdk-js","id":1038735190},"schema_version":1}
