{"data":{"body":"**P2 \u2014 Preserve the published Node 20 contract.** Raising this public package's engine to Node 22 makes existing Node 20 installations fail under `engine-strict`, although the upgraded MCP SDK itself supports Node >=18. Keep `>=20` and add a Node 20 CLI smoke test, or release and document this as a breaking support change.","comment_node_id":"PRRC_kwDOPenXVs78tJta","finding_digest":"a95ae1084d51848d88550e37a2baa5f91fbea75ea5236bac2d8c336ff49800da","finding_id":"arf_v1_vfnocccnkgci3ccvby32fovf7e","finding_key":"insight-mcp::engines::node20-public-compatibility","identity_key":"insight-mcp::engines::node20-public-compatibility","line":12,"observation_digest":"53ecf205a7352474e07cdbc2403633cb46fed57c6cfeac675f51131c67a09d72","observation_id":"aro_v1_kpwpebnhgushjyd43pbeanrtzn","path":"packages/aws-durable-execution-sdk-js-insight-mcp/package.json","prior_finding_id":"","published_at":"2026-10-11T00:18:22Z","review_id":"arr_v1_by46yjsmgkp5wc5e2k67q46g6b","reviewed_base_sha":"25e0eaf8af1930e48e698eec3382c42ca37649c7","reviewed_head_sha":"e67178851fc68587699919de5524c9ac02224bc5","reviewer":"codex","start_line":12,"suggestion_id":""},"pull_request":{"number":985},"record_id":"art_v1_ksei7t6hf72ygjdnlpcmiekbww","record_type":"finding_observed","recorded_at":"2026-10-11T00:18:22Z","repository":{"full_name":"aws/aws-durable-execution-sdk-js","id":1038735190},"schema_version":1}
