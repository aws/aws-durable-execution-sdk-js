{"data":{"body":"**P2 \u2014 Exercise Electron 44 in CI.** PR jobs skip the Electron binary download, desktop tests mock Electron, and the host job only runs esbuild, so neither the upgraded runtime nor its packaging is launched. Startup or packaging regressions across the Electron 32\u219244 jump can merge unnoticed. Add a PR-gated startup smoke test and an `electron-builder --dir` package check for at least one supported target.","comment_node_id":"PRRC_kwDOPenXVs78tNsT","finding_digest":"189b17eba5d4540476c1071343d2eb05ac970c0f6b7c10a759cd5d379db58265","finding_id":"arf_v1_dcnrp25f2rkai5wba4juhuxlaw","finding_key":"insight-desktop::electron-upgrade::runtime-packaging-smoke-coverage","identity_key":"insight-desktop::electron-upgrade::runtime-packaging-smoke-coverage","line":31,"observation_digest":"dee84e93f3e55142ba9c76c88657daff8c18186f4fac6abe9c0e795474bc87b0","observation_id":"aro_v1_33ue5e7t4viufou4o3eimv6276","path":"packages/aws-durable-execution-sdk-js-insight-desktop/package.json","prior_finding_id":"arf_v1_dcnrp25f2rkai5wba4juhuxlaw","published_at":"2026-10-11T00:25:11Z","review_id":"arr_v1_aeyrlw7qx6xyahtk5n4fhosfnb","reviewed_base_sha":"25e0eaf8af1930e48e698eec3382c42ca37649c7","reviewed_head_sha":"964d9b2f062c3090027beda2eb721171c02181d4","reviewer":"codex","start_line":31,"suggestion_id":""},"pull_request":{"number":985},"record_id":"art_v1_4xo4udmoqcrbotjbobz6o6lswi","record_type":"finding_observed","recorded_at":"2026-10-11T00:25:11Z","repository":{"full_name":"aws/aws-durable-execution-sdk-js","id":1038735190},"schema_version":1}
