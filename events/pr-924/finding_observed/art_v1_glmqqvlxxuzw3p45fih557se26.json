{"data":{"body":"[P2] Reject explicit exclusive-group conflicts before evaluating environment-selected modules. This check now runs early only when there are no dynamic specifiers, so an already-invalid pair of explicit factories causes every configured module to be imported\u2014and potentially execute global tracer/provider side effects\u2014before the eventual `PluginLoadError`. Validate the explicit factories unconditionally here, retain the final validation after dynamic factories are appended, and test that the importer is not called for an explicit conflict.","comment_node_id":"PRRC_kwDOPenXVs77Ep0x","finding_digest":"bcdac348bfc63ed0f60825093529774a9e5d639f34b3941015f9908ceae263f3","finding_id":"arf_v1_xtnmgsf7yy7nb5qieuetkklxjk","finding_key":"packages/aws-durable-execution-sdk-js/src/utils/plugin/plugin-loader.ts::loadconfiguredplugins::explicit-conflict-before-module-import","identity_key":"packages/aws-durable-execution-sdk-js/src/utils/plugin/plugin-loader.ts::loadconfiguredplugins::explicit-conflict-before-module-import","line":382,"observation_digest":"3600bc4b11dbfa37f4dabc0d52bbbca80dffb67f9a45ab457a206315a7053d00","observation_id":"aro_v1_gyalysyr3p5dp5g2xqgvfo54va","path":"packages/aws-durable-execution-sdk-js/src/utils/plugin/plugin-loader.ts","prior_finding_id":"","published_at":"2026-10-07T21:43:01Z","review_id":"arr_v1_nt5urbcazjiwybiqznzg2plbup","reviewed_base_sha":"19ee19fa0619093943f079b69943f7b5cdee7ac7","reviewed_head_sha":"393ad66fb75c53929621aa53c27fb0a319133244","reviewer":"codex","start_line":381,"suggestion_id":"arsg_v1_cfwrpsqd3twtykcwgundhxo5zt"},"pull_request":{"number":924},"record_id":"art_v1_glmqqvlxxuzw3p45fih557se26","record_type":"finding_observed","recorded_at":"2026-10-07T21:43:01Z","repository":{"full_name":"aws/aws-durable-execution-sdk-js","id":1038735190},"schema_version":1}
