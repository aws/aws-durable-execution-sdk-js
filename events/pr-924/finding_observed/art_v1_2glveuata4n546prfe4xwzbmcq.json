{"data":{"body":"**P2 \u2014 Do not close nonterminal invocations.** `PENDING` and `RETRYING` ends are mapped to `RUNNING`, but this assignment causes every later operation-change hook to be discarded. A late checkpoint update can therefore contain newer operation state than the exported running snapshot. Set `closed` only for terminal statuses, ensure late nonterminal updates are drained before returning, and add regression coverage for `PENDING`/`RETRYING` followed by an operation change.","comment_node_id":"PRRC_kwDOPenXVs74mo3H","finding_digest":"303da5c2ed28b594cf05f52cfd2a139d2e0ed549d2e76351c6ffa0892c16b3a5","finding_id":"arf_v1_ga62lqxnfc2zjtyf6uwp2kqttu","finding_key":"packages/aws-durable-execution-sdk-js-insight/src/index.ts::workflowinsightinvocation-oninvocationend::nonterminal-late-change-drop","identity_key":"packages/aws-durable-execution-sdk-js-insight/src/index.ts::workflowinsightinvocation-oninvocationend::nonterminal-late-change-drop","line":962,"observation_digest":"97f46b28c32637e808a52f05360d81ce6570ffe3d49dc826dd4aa87b313a180d","observation_id":"aro_v1_s72gwkgdey36qcfff4ctmdmbzz","path":"packages/aws-durable-execution-sdk-js-insight/src/index.ts","prior_finding_id":"","published_at":"2026-10-03T00:19:55Z","review_id":"arr_v1_ldc4a5l4actw7e5do4a3ns5gjw","reviewed_base_sha":"0ee6c027ca3b58f3bf270fdf4a9ac87b73752467","reviewed_head_sha":"1a8eb5bdbcb5147cd7bd7c2df2b64a12ddea6d17","reviewer":"codex","start_line":962,"suggestion_id":""},"pull_request":{"number":924},"record_id":"art_v1_2glveuata4n546prfe4xwzbmcq","record_type":"finding_observed","recorded_at":"2026-10-03T00:19:55Z","repository":{"full_name":"aws/aws-durable-execution-sdk-js","id":1038735190},"schema_version":1}
