{"data":{"body":"**P2 \u2014 Type the documented nullish factory result.** The runtime and documentation support returning `null` or `undefined` to skip a plugin for an invocation, but this signature rejects that behavior for TypeScript consumers; even the new unit test requires an unsafe cast. Change the return type to `Plugin | null | undefined`, widen the local variable in `plugin-factory.ts`, and remove the test cast.","comment_node_id":"PRRC_kwDOPenXVs74qjnL","finding_digest":"eb3e65a619b347307dcd311f42a1758ebdc3b479ddf84b19d5f54d1d83920cdc","finding_id":"arf_v1_5m7gljqzwndta7ongepufilvr2","finding_key":"packages/aws-durable-execution-sdk-js/src/types/plugin.ts::durableinstrumentationpluginfactory-createplugin::nullish-return-contract","identity_key":"packages/aws-durable-execution-sdk-js/src/types/plugin.ts::durableinstrumentationpluginfactory-createplugin::nullish-return-contract","line":319,"observation_digest":"1ed9d32834bce61f8e7b6ac59004edef137f3cde82bd8621d0eaa68e2d3e687f","observation_id":"aro_v1_d3m5gkbuxttb7dt3nlczabhn54","path":"packages/aws-durable-execution-sdk-js/src/types/plugin.ts","prior_finding_id":"","published_at":"2026-10-03T05:47:18Z","review_id":"arr_v1_rg2yh5mjhrdxtmruehgc3np5wa","reviewed_base_sha":"0ee6c027ca3b58f3bf270fdf4a9ac87b73752467","reviewed_head_sha":"cdaeefeaccbd95b68d145dfa8ea6c2c165026991","reviewer":"codex","start_line":319,"suggestion_id":""},"pull_request":{"number":924},"record_id":"art_v1_aeyshzmeh2xhpf52ztf6ewexdw","record_type":"finding_observed","recorded_at":"2026-10-03T05:47:18Z","repository":{"full_name":"aws/aws-durable-execution-sdk-js","id":1038735190},"schema_version":1}
