{"data":{"body":"This unconditionally forces 16 concurrent test files for the documented personal-account integration workflow as well as CI. AWS concurrency and API quotas vary, so these runs can now be throttled and, because `bail: true`, aborted. Gate this CI-tuned override on `process.env.CI` (or an explicit opt-in variable) so local runs retain Jest's adaptive default.","comment_node_id":"PRRC_kwDOPenXVs78_vMg","finding_digest":"1ee2323443c1b0b3b7347d7bd345602c582b73061796e4993aa8dba70379761d","finding_id":"arf_v1_d3rdencdygylhnzupv55grlafr","finding_key":"examples/jest.config.integration.js::maxworkers::ci-only-scope","identity_key":"examples/jest.config.integration.js::maxworkers::ci-only-scope","line":20,"observation_digest":"c10dfb05063a0bafc2b780506373b7071a4bbaa8e7df073386ba937fd2f83702","observation_id":"aro_v1_yeg7wbighif27qvxqbigg45xa4","path":"packages/aws-durable-execution-sdk-js-examples/jest.config.integration.js","prior_finding_id":"","published_at":"2026-10-12T04:00:08Z","review_id":"arr_v1_aoppeszhfe7kkkqukgtp6rtcwr","reviewed_base_sha":"2a7240b246bc358e2861f7f4e9115c65e89ec5c9","reviewed_head_sha":"c74f0bebac71095fb180774060c7802358796b01","reviewer":"codex","start_line":20,"suggestion_id":"arsg_v1_flq2c244mzhbfb36fn764e2ip3"},"pull_request":{"number":988},"record_id":"art_v1_6ctfpfikfihc6k3zjzimmsjwoy","record_type":"finding_observed","recorded_at":"2026-10-12T04:00:08Z","repository":{"full_name":"aws/aws-durable-execution-sdk-js","id":1038735190},"schema_version":1}
