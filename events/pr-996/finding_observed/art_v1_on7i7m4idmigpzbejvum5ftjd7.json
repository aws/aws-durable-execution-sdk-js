{"data":{"body":"**[P2] Require an absolute end-of-string match.** JavaScript's `$` also matches immediately before a final line terminator, so values such as a step name `\"charge\\n\"` pass this printable-ASCII check locally even though the service rejects them. Use an absolute-end assertion and add regression cases for trailing `\\n`, `\\r`, and Unicode line separators.","comment_node_id":"PRRC_kwDOPenXVs7-UVGa","finding_digest":"4beb65664db3d17eb44865aebb758cb6a2a9de0b5a4963fd03fea5fb92dad4c1","finding_id":"arf_v1_jpvwkzsnwpix5ncimwxlw5mmw2","finding_key":"checkpoint-server/validate-update-model::string-errors::absolute-end-pattern-matching","identity_key":"checkpoint-server/validate-update-model::string-errors::absolute-end-pattern-matching","line":289,"observation_digest":"1351ac5a6e79a3af7d6fccf6928a16215f8a282b23ef4ad4f89157bb597db667","observation_id":"aro_v1_cni2ywtopgr267lpzt3jfcqwef","path":"packages/aws-durable-execution-sdk-js-testing/src/checkpoint-server/validators/validate-update-model.ts","prior_finding_id":"","published_at":"2026-10-14T04:22:18Z","review_id":"arr_v1_y66p4vusi3wvlofj4lxnxelh2y","reviewed_base_sha":"08ba0f6e29d7faaaaa99a6acde407db9c9854e2f","reviewed_head_sha":"f7f854d1915d17aa496a99d5344ea7e1641cbb97","reviewer":"codex","start_line":289,"suggestion_id":"arsg_v1_s6hpvsjtpe32dxfdxuwu3ky7ng"},"pull_request":{"number":996},"record_id":"art_v1_on7i7m4idmigpzbejvum5ftjd7","record_type":"finding_observed","recorded_at":"2026-10-14T04:22:18Z","repository":{"full_name":"aws/aws-durable-execution-sdk-js","id":1038735190},"schema_version":1}
