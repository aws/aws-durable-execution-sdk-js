{"data":{"body":"**[P2] Preserve error status for cancelled operations.** `CANCELLED` is terminal and causes callback/invoke promises to reject, but this mapper leaves an errorless cancellation `UNSET`. Since this PR also removes synthesized live-hook errors, those spans regress from `ERROR`. Include `CANCELLED` here and add no-error cancellation coverage for both views and delivery paths.","comment_node_id":"PRRC_kwDOPenXVs7-zM00","finding_digest":"db6fd12e49dc8fe0e00ccc5c42a4ca4308f7bd9ac248cc97a299b37d36ebc684","finding_id":"arf_v1_3nx5clsj3sh6byamzroefjgkim","finding_key":"packages/aws-durable-execution-sdk-js-otel/src/operation-span-status.ts::setoperationspanstatus::cancelled-terminal-status","identity_key":"packages/aws-durable-execution-sdk-js-otel/src/operation-span-status.ts::setoperationspanstatus::cancelled-terminal-status","line":13,"observation_digest":"c03a5bd95d2e41a0f3a20870ca1428a8297c8f179d060184b872b120b751ac40","observation_id":"aro_v1_ya5fxwk5fza2b45cbbymufbiva","path":"packages/aws-durable-execution-sdk-js-otel/src/operation-span-status.ts","prior_finding_id":"","published_at":"2026-10-14T18:42:36Z","review_id":"arr_v1_4xl354z6iqlotjzgad3pcmx4n2","reviewed_base_sha":"08ba0f6e29d7faaaaa99a6acde407db9c9854e2f","reviewed_head_sha":"78bf0cc565d85546ff0bf026e76e1924b7c48c41","reviewer":"codex","start_line":10,"suggestion_id":"arsg_v1_tivj4toqjbt576nyg5ic4spgta"},"pull_request":{"number":960},"record_id":"art_v1_flhykaq5q3rviw63olndbb6nuu","record_type":"finding_observed","recorded_at":"2026-10-14T18:42:36Z","repository":{"full_name":"aws/aws-durable-execution-sdk-js","id":1038735190},"schema_version":1}
