{"data":{"body":"**[P3] Ignore undefined future fields when detecting error details.** The unknown-field branch treats `{ FutureDetail: undefined }` as meaningful data, producing an `Unknown error` and spurious exception telemetry. Count only defined values and update that unit case to expect `undefined`.","comment_node_id":"PRRC_kwDOPenXVs7-PUEE","finding_digest":"d94b13925de13f929bcde1771412a3892a8f913b2055c6e240c5aba5c0f3547b","finding_id":"arf_v1_3ffrhes54e7zfg6n4f3rievdre","finding_key":"packages/aws-durable-execution-sdk-js/src/utils/operation/operation.ts::tooperationinfo::unknown-error-detail-preservation","identity_key":"packages/aws-durable-execution-sdk-js/src/utils/operation/operation.ts::tooperationinfo::unknown-error-detail-preservation","line":48,"observation_digest":"8001101960b96c653ef2515a83029386e17f054acc8a5578b155d0a74dc7b534","observation_id":"aro_v1_qaaraglaxfwgkpxskfnigautq3","path":"packages/aws-durable-execution-sdk-js/src/utils/operation/operation.ts","prior_finding_id":"arf_v1_3ffrhes54e7zfg6n4f3rievdre","published_at":"2026-10-14T00:13:18Z","review_id":"arr_v1_opunite3lxkuovdckynur4jvtc","reviewed_base_sha":"08ba0f6e29d7faaaaa99a6acde407db9c9854e2f","reviewed_head_sha":"64d012eac519c341689ad42da825e174383e8ff9","reviewer":"codex","start_line":42,"suggestion_id":"arsg_v1_fexgunakp3gbzjdcytslcwdgss"},"pull_request":{"number":960},"record_id":"art_v1_3gpfyflj3e3ocoxiruwjtgn3yr","record_type":"finding_observed","recorded_at":"2026-10-14T00:13:18Z","repository":{"full_name":"aws/aws-durable-execution-sdk-js","id":1038735190},"schema_version":1}
