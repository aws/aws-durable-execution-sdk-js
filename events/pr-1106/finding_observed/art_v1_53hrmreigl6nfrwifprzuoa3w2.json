{"data":{"body":"[P3] Fully qualify the Redshift IAM actions\n\n`DescribeStatement` and `GetStatementResult` are missing the `redshift-data:` prefix. Copying these entries into an IAM policy produces invalid actions, leaving the polling and result-fetching calls in `redshift.ts` unauthorized. List them as `redshift-data:DescribeStatement` and `redshift-data:GetStatementResult`.","comment_node_id":"PRRC_kwDOPenXVs8AAAABBQqj9A","finding_digest":"a9b451bd0001fb18a2d3e981806e795267db02fd7f0a4497e4fac66cd5a38a97","finding_id":"arf_v1_vg2fdpiaah5rriwt5gaya3tzkj","finding_key":"telemetry-vscode/readme.md::required-iam-permissions::unqualified-redshift-actions","identity_key":"telemetry-vscode/readme.md::required-iam-permissions::unqualified-redshift-actions","line":389,"observation_digest":"c5db3edfe39200cdd47e8c06f2d870ad7a4f78cf7d71adc961d1bc9559cec35c","observation_id":"aro_v1_yxnt5x7dsiam3vd6rqdpfwdqvv","path":"packages/aws-durable-execution-sdk-js-telemetry-vscode/README.md","prior_finding_id":"","published_at":"2026-10-26T16:08:44Z","review_id":"arr_v1_gbw3qbv5ylfqwm7cmi57iiz7hn","reviewed_base_sha":"67549feacd5568ea305b7c2d533d3549974f8c9c","reviewed_head_sha":"efcac53fcf526f01b37a4ac05fb656e94c1458ee","reviewer":"codex","start_line":389,"suggestion_id":""},"pull_request":{"number":1106},"record_id":"art_v1_53hrmreigl6nfrwifprzuoa3w2","record_type":"finding_observed","recorded_at":"2026-10-26T16:08:44Z","repository":{"full_name":"aws/aws-durable-execution-sdk-js","id":1038735190},"schema_version":1}
