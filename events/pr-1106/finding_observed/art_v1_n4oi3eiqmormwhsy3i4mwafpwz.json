{"data":{"body":"[P2] Include GET permissions for OpenSearch reads\n\nFollowing the new instruction to grant only the listed actions leaves connection checks and record drill-down unauthorized. `pingOpenSearch`, `countOpenSearchDocs`, and `fetchOpenSearchRecord` issue GET requests, which `es:ESHttpPost` does not authorize. Add `es:ESHttpGet` scoped to the required domain/index read paths alongside the SQL POST permission.","comment_node_id":"PRRC_kwDOPenXVs8AAAABBQkGnw","finding_digest":"67f6900b4a309d979805a419239b043d61b2e189b5c778dfd7a395345fa2f30c","finding_id":"arf_v1_m73jac2kgcozpgafuqmshgyehv","finding_key":"telemetry-vscode/readme.md::required-iam-permissions::missing-opensearch-get","identity_key":"telemetry-vscode/readme.md::required-iam-permissions::missing-opensearch-get","line":390,"observation_digest":"d093f0337d02c1674871a517afbf3a8af375388501ea492907832519975c8fcf","observation_id":"aro_v1_2cj7am35alawosdruul27pz2rl","path":"packages/aws-durable-execution-sdk-js-telemetry-vscode/README.md","prior_finding_id":"arf_v1_m73jac2kgcozpgafuqmshgyehv","published_at":"2026-10-26T15:59:03Z","review_id":"arr_v1_gu66f5tqhczpk3cs5hh32n3k5k","reviewed_base_sha":"67549feacd5568ea305b7c2d533d3549974f8c9c","reviewed_head_sha":"8ae6bdab6bdf86aacadcfdbe2fed33774a58e223","reviewer":"codex","start_line":390,"suggestion_id":""},"pull_request":{"number":1106},"record_id":"art_v1_n4oi3eiqmormwhsy3i4mwafpwz","record_type":"finding_observed","recorded_at":"2026-10-26T15:59:03Z","repository":{"full_name":"aws/aws-durable-execution-sdk-js","id":1038735190},"schema_version":1}
