{"data":{"body":"[P2] Include GET permissions for OpenSearch reads\n\nFollowing the new instruction to grant only the listed actions leaves connection checks and record drill-down unauthorized. `pingOpenSearch` and `countOpenSearchDocs` issue GET requests, and `fetchOpenSearchRecord` uses GET for individual documents; `es:ESHttpPost` covers none of these. Add `es:ESHttpGet` scoped to the required domain/index read paths alongside the SQL POST permission.","comment_node_id":"PRRC_kwDOPenXVs8AAAABBQhQpw","finding_digest":"67f6900b4a309d979805a419239b043d61b2e189b5c778dfd7a395345fa2f30c","finding_id":"arf_v1_m73jac2kgcozpgafuqmshgyehv","finding_key":"telemetry-vscode/readme.md::required-iam-permissions::missing-opensearch-get","identity_key":"telemetry-vscode/readme.md::required-iam-permissions::missing-opensearch-get","line":390,"observation_digest":"07106737bc74179450042ce7c53c12f25bef7769e80e9397828ebc966e310357","observation_id":"aro_v1_a4igon54oqlziuaeftt4kpas6j","path":"packages/aws-durable-execution-sdk-js-telemetry-vscode/README.md","prior_finding_id":"","published_at":"2026-10-26T15:55:17Z","review_id":"arr_v1_m37xirchrl6s4wh6667aid7rc4","reviewed_base_sha":"67549feacd5568ea305b7c2d533d3549974f8c9c","reviewed_head_sha":"8ae6bdab6bdf86aacadcfdbe2fed33774a58e223","reviewer":"codex","start_line":390,"suggestion_id":""},"pull_request":{"number":1106},"record_id":"art_v1_ybqsywtqflccsllghvgr2q3mw4","record_type":"finding_observed","recorded_at":"2026-10-26T15:55:17Z","repository":{"full_name":"aws/aws-durable-execution-sdk-js","id":1038735190},"schema_version":1}
