{"data":{"body":"**P2 \u2014 Preserve the final error-type assertion**\n\nThis message-only check drops the previous verification that failures surface as `PromiseCombinatorError`. The event-signature and per-step assertions do not inspect the execution error payload, so a regression to `Error` or `ChildContextError` with the same message would pass. Retain the scheduling tolerance while restoring the exact `getError()` assertion.","comment_node_id":"PRRC_kwDOPenXVs74qHzu","finding_digest":"0602ca001bdf246ac8f4e455917122781217648ed2686ddc8f7617f67d8e6076","finding_id":"arf_v1_aybmuaa334sgvshu4rkzc4jcpa","finding_key":"packages/aws-durable-execution-sdk-js-examples/src/examples/promise/any/promise-any.test.ts::failure-case::final-error-type-coverage","identity_key":"packages/aws-durable-execution-sdk-js-examples/src/examples/promise/any/promise-any.test.ts::failure-case::final-error-type-coverage","line":41,"observation_digest":"ca32107420abc7d7159377b986452141027fa2f5421412d0a59cc445425ef483","observation_id":"aro_v1_zizba5bavpd5ofmto64ymrjbie","path":"packages/aws-durable-execution-sdk-js-examples/src/examples/promise/any/promise-any.test.ts","prior_finding_id":"","published_at":"2026-10-03T05:08:35Z","review_id":"arr_v1_ja5fs56z7ul6ejj66h3tdyspw5","reviewed_base_sha":"0ee6c027ca3b58f3bf270fdf4a9ac87b73752467","reviewed_head_sha":"5e9151ff84f4d1cd4ef7d50dbfa117358bed451f","reviewer":"codex","start_line":41,"suggestion_id":"arsg_v1_jvpuxjjkztdfzsdw6of4lq56gw"},"pull_request":{"number":959},"record_id":"art_v1_epagitxrshq7e7qyazkqywlnnr","record_type":"finding_observed","recorded_at":"2026-10-03T05:08:35Z","repository":{"full_name":"aws/aws-durable-execution-sdk-js","id":1038735190},"schema_version":1}
