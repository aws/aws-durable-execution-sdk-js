{"data":{"body":"**P2 \u2014 Restore the final combinator error assertion**\n\nThis checks only the message thrown by `getResult()`. The per-step assertions do not verify that the execution-level failure remains a `PromiseCombinatorError`, so another error type with the same message would pass. Retain the scheduling tolerance while restoring the exact `getError()` assertion, including `errorType`.","comment_node_id":"PRRC_kwDOPenXVs745Gm5","finding_digest":"0602ca001bdf246ac8f4e455917122781217648ed2686ddc8f7617f67d8e6076","finding_id":"arf_v1_aybmuaa334sgvshu4rkzc4jcpa","finding_key":"packages/aws-durable-execution-sdk-js-examples/src/examples/promise/any/promise-any.test.ts::failure-case::final-error-type-coverage","identity_key":"packages/aws-durable-execution-sdk-js-examples/src/examples/promise/any/promise-any.test.ts::failure-case::final-error-type-coverage","line":41,"observation_digest":"1a674cecba61f3fe39928a02a46640737e85147e62ccfd357855792130fc5f24","observation_id":"aro_v1_djtuz3f2mhz74omsribkizsaon","path":"packages/aws-durable-execution-sdk-js-examples/src/examples/promise/any/promise-any.test.ts","prior_finding_id":"arf_v1_aybmuaa334sgvshu4rkzc4jcpa","published_at":"2026-10-04T01:41:43Z","review_id":"arr_v1_vgcndwuaskgtrrljgicrt2xklq","reviewed_base_sha":"cc7db9bacb23278c58aecf16821737ba47797152","reviewed_head_sha":"32a6a5266b1456855fe1765ba6223e4cf502f093","reviewer":"codex","start_line":41,"suggestion_id":"arsg_v1_px2rz54ww3baagtukitbcwefq6"},"pull_request":{"number":959},"record_id":"art_v1_74x5pnkft5vavq2anyx5iin334","record_type":"finding_observed","recorded_at":"2026-10-04T01:41:43Z","repository":{"full_name":"aws/aws-durable-execution-sdk-js","id":1038735190},"schema_version":1}
