{"data":{"body":"[P3] Use the required composed-test filename suffix\n\nRoot AGENTS.md, Tests rule 2, and TESTING.md require composed tests to end in `.composed.test.ts`. This file connects real internal components with faked external services, but `session-worker-composed.test.ts` has the unit-test suffix. Rename it to `session-worker.composed.test.ts` so filename-based classification identifies it correctly.","comment_node_id":"PRRC_kwDOPenXVs8AAAABFzdFpw","finding_digest":"a899a876bba96c293fd80a447db97ce31928ce0cd57d196cdeb07be114440d7a","finding_id":"arf_v1_vcm2q5v3vfwcsp6ybjch3ol44m","finding_key":"extensions/agentcore::session-worker-composition::composed-test-suffix","identity_key":"extensions/agentcore::session-worker-composition::composed-test-suffix","line":118,"observation_digest":"a23a1338f423feb9aa15d88506879d92ae5767058c988e6b8935124bcc2afdc0","observation_id":"aro_v1_ui5bgohuep7ltkqv3ccqnb45sk","path":"packages/aws-durable-execution-sdk-js-extensions/src/compute/agentcore/__tests__/session-worker-composed.test.ts","prior_finding_id":"arf_v1_vcm2q5v3vfwcsp6ybjch3ol44m","published_at":"2026-11-24T18:10:58Z","review_id":"arr_v1_4ncge2ha7wucyofwa47yolzs7d","reviewed_base_sha":"2a12386a815a1b72bb94ef113457fdc4aa3b2968","reviewed_head_sha":"8e7b2361aaeeefb0e9b1f1b1d49345f6231b3dea","reviewer":"codex","start_line":117,"suggestion_id":""},"pull_request":{"number":1284},"record_id":"art_v1_pjvbql7wscthvms333ns3p7wa2","record_type":"finding_observed","recorded_at":"2026-11-24T18:10:58Z","repository":{"full_name":"aws/aws-durable-execution-sdk-js","id":1038735190},"schema_version":1}
