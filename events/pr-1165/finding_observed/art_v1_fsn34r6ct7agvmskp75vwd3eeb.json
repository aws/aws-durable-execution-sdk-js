{"data":{"body":"[P2] Align the VS Code types with the supported minimum\n\n`engines.vscode` remains `^1.140.0`, but this raises the types minimum to 1.144.0. The release workflow\u2019s `vsce package` validation rejects types newer than the declared minimum supported VS Code version, preventing VSIX creation even when compilation and unit tests pass. Keep the types on 1.140.x and refresh the lockfile, or deliberately raise and document the extension\u2019s supported minimum.","comment_node_id":"PRRC_kwDOPenXVs8AAAABCR7zRQ","finding_digest":"29f4ac6ce82d1cb0c480e61aee016d38ee69937a1a2c49fea7f11a62a39a2c8a","finding_id":"arf_v1_fh2ky3hifuolbrea4yno4alnhd","finding_key":"telemetry-vscode::types-vscode::engine-version-compatibility","identity_key":"telemetry-vscode::types-vscode::engine-version-compatibility","line":314,"observation_digest":"4193be567479cd6ac95f0aa2bb7e7040b1592766f1cb7407829a69b2d74cc0ac","observation_id":"aro_v1_igj34vtuphgwvsk7bkrlw7tqic","path":"packages/aws-durable-execution-sdk-js-telemetry-vscode/package.json","prior_finding_id":"","published_at":"2026-11-02T21:32:10Z","review_id":"arr_v1_c473biufgjzcw66pdpmmdudwct","reviewed_base_sha":"f7e19e66ec2d33caacbc3ce5526a0a4ec355340a","reviewed_head_sha":"b130aa8df48af4c8f037a51ab86e4d4c8c80e446","reviewer":"codex","start_line":314,"suggestion_id":""},"pull_request":{"number":1165},"record_id":"art_v1_fsn34r6ct7agvmskp75vwd3eeb","record_type":"finding_observed","recorded_at":"2026-11-02T21:32:10Z","repository":{"full_name":"aws/aws-durable-execution-sdk-js","id":1038735190},"schema_version":1}
