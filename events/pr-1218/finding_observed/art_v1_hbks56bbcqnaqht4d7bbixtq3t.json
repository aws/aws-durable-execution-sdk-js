{"data":{"body":"[P2] Require coverage for the ESM missing-module branch\n\nAll missing-SDK fixtures use `MODULE_NOT_FOUND`; none supplies `ERR_MODULE_NOT_FOUND`. Removing the first comparison therefore leaves their assertions unchanged while losing the installation guidance for ESM missing-package errors. This violates CONTRIBUTING rule 4. Return to the optional-dependency testing design and require both error codes to produce the package-specific installation message.","comment_node_id":"PRRC_kwDOPenXVs8AAAABD6MuiA","finding_digest":"117f4fae9b531e94d4cad36ddcba78d631529830a621ed9fa1fee93ec49c840b","finding_id":"arf_v1_cf7u7lu3kmpjjvgk2nw5zoty2y","finding_key":"extras/ai/aws-sdk.ts::sdkloaderror::esm-missing-module-branch-coverage","identity_key":"extras/ai/aws-sdk.ts::sdkloaderror::esm-missing-module-branch-coverage","line":24,"observation_digest":"2701e1ce11d722c0e4215abb0db11ca2d4bde4184046e6209f41316586b0acba","observation_id":"aro_v1_e4a6dtqr24rmbzbblk5q3mi4ul","path":"packages/aws-durable-execution-sdk-js-extras/src/ai/aws-sdk.ts","prior_finding_id":"","published_at":"2026-11-12T22:46:51Z","review_id":"arr_v1_xhxxosjqs3rpytvhbiyz3nj35y","reviewed_base_sha":"48173acd2de943ce5fb43de8dd3683b9bcf8ab50","reviewed_head_sha":"6684e5dff94c5c1237e33f99a92dafa96a7093ac","reviewer":"codex","start_line":24,"suggestion_id":""},"pull_request":{"number":1218},"record_id":"art_v1_hbks56bbcqnaqht4d7bbixtq3t","record_type":"finding_observed","recorded_at":"2026-11-12T22:46:51Z","repository":{"full_name":"aws/aws-durable-execution-sdk-js","id":1038735190},"schema_version":1}
