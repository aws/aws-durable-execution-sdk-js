{"data":{"body":"[P2] Consolidate the non-string choice validation\n\n`classify()` now rejects non-string choices before calling `matchOption()`, its only caller. Consequently, the added non-string tests never reach this guard, and deleting it leaves every assertion unchanged. This retains an unreachable defensive branch, contrary to CONTRIBUTING rule 4. Return to the validation design and keep the string check at one boundary, with the helper accepting the already-validated string.","comment_node_id":"PRRC_kwDOPenXVs8AAAABEakkWg","finding_digest":"3a20950acb7248154b3dfbf7cb1e0d124380c586bb713066d9a2b80c8aca9b85","finding_id":"arf_v1_hiqjkcwlojebksz57p34whqncj","finding_key":"extras/ai/shared.ts::matchoption::nonstring-choice-branch-coverage","identity_key":"extras/ai/shared.ts::matchoption::nonstring-choice-branch-coverage","line":335,"observation_digest":"b1335b228cc593cbf1dd50ff2cf389e677067773e1e0b43cebe52cfdcc79d2aa","observation_id":"aro_v1_wezvwiumywj4x4o5kd7sz44j4z","path":"packages/aws-durable-execution-sdk-js-extras/src/ai/shared.ts","prior_finding_id":"arf_v1_hiqjkcwlojebksz57p34whqncj","published_at":"2026-11-16T20:41:31Z","review_id":"arr_v1_rxctalppm4p7twxxka3hooarsb","reviewed_base_sha":"672f510fd2010e0bcdec86c5d4665c97e7029e0a","reviewed_head_sha":"5cc0b75a5538f5208e20083e3735e28797bde0aa","reviewer":"codex","start_line":333,"suggestion_id":""},"pull_request":{"number":1218},"record_id":"art_v1_ftuegfgrwayvgoa5ppv6qcu4so","record_type":"finding_observed","recorded_at":"2026-11-16T20:41:31Z","repository":{"full_name":"aws/aws-durable-execution-sdk-js","id":1038735190},"schema_version":1}
