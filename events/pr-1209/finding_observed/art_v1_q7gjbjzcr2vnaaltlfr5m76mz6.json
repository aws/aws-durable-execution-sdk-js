{"data":{"body":"[P2] Keep the stored payload distinct from its preview\n\nWith the `readFile` assertion removed, the file contents and `envelope.preview` are identical, so returning the preview without reading the file now satisfies this test. This weakens the unit regression guard against substituting a partial or masked preview for the complete result. Give the stored value a field absent from the preview and retain the complete-value assertion.","comment_node_id":"PRRC_kwDOPenXVs8AAAABDWsS1A","finding_digest":"93843a02d6c60bf3376ba9f141a1f4a4a2ae94db586bd8d5b6cf46004b5dc697","finding_id":"arf_v1_socduawwyyf7gn3lvhyudipuus","finding_key":"packages/aws-durable-execution-sdk-js/src/utils/serdes/filesystem-serdes.test.ts::deserialize::preview-payload-distinction","identity_key":"packages/aws-durable-execution-sdk-js/src/utils/serdes/filesystem-serdes.test.ts::deserialize::preview-payload-distinction","line":452,"observation_digest":"e12cb212e1debfc920c9dfd1d37cb3e828241c471294a4d5b77f20583542fd60","observation_id":"aro_v1_4ewleexb3274sigj37i5g7ft5a","path":"packages/aws-durable-execution-sdk-js/src/utils/serdes/filesystem-serdes.test.ts","prior_finding_id":"","published_at":"2026-11-10T01:31:26Z","review_id":"arr_v1_33ykendo766nocudkoj5mrkuml","reviewed_base_sha":"584ab381861da2a2f2bbf814c0f894d53cf7101f","reviewed_head_sha":"37047e15898ab2eb7f034f9da11f94eb48684d26","reviewer":"codex","start_line":451,"suggestion_id":"arsg_v1_hkhqsqwcr7a2cvrku5azfoehos"},"pull_request":{"number":1209},"record_id":"art_v1_q7gjbjzcr2vnaaltlfr5m76mz6","record_type":"finding_observed","recorded_at":"2026-11-10T01:31:26Z","repository":{"full_name":"aws/aws-durable-execution-sdk-js","id":1038735190},"schema_version":1}
