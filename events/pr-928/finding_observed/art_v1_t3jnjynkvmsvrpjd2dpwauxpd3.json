{"data":{"body":"[P3] Exclude observability cloud tests from the local command\n\nThis command also collects `test_observability_cloud.py`, whose cases require `--cloud` and a deployed manifest. Following the documented local sequence therefore produces fixture errors before deployment. Exclude both cloud files, as the harness workflow already does.","comment_node_id":"PRRC_kwDOPenXVs8AAAABBCYdmg","finding_digest":"d0997f7de50ed67316a4f9a92fb91117d681a3ce6b5d03f9b66985cec58c7924","finding_id":"arf_v1_2cmx67pfb3lhgfve7gus7oirc7","finding_key":"lmi-tests/readme.md::run::local-command-collects-cloud-tests","identity_key":"lmi-tests/readme.md::run::local-command-collects-cloud-tests","line":169,"observation_digest":"edea54e6988ba4549145cb6c49718bed66b8196b24a2ab6770539a376b7d8c0f","observation_id":"aro_v1_5xvfjzuyrosfjekfznwes4ml5v","path":"lmi-tests/README.md","prior_finding_id":"","published_at":"2026-10-23T21:57:34Z","review_id":"arr_v1_ta6u6c365sw2gghlut4c7r7meo","reviewed_base_sha":"c0a7e3497f54fb451e13f54bd9b5604eedde771c","reviewed_head_sha":"07a7ac5bfe5a8d942dc9801bea2e72416c977de4","reviewer":"codex","start_line":169,"suggestion_id":"arsg_v1_l4j7gxcyatstqs5wl6j7earfrm"},"pull_request":{"number":928},"record_id":"art_v1_t3jnjynkvmsvrpjd2dpwauxpd3","record_type":"finding_observed","recorded_at":"2026-10-23T21:57:34Z","repository":{"full_name":"aws/aws-durable-execution-sdk-js","id":1038735190},"schema_version":1}
