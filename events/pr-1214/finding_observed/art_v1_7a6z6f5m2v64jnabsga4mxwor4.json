{"data":{"body":"[P2] Restrict comments to runs that test the PR. `Build` also runs on `pull_request_target` label/unlabel events, and same-repository PRs pass its integration-job condition. Those runs check out the base revision but still populate this PR number. After this change merges, adding a label can therefore replace a genuine PR slowdown warning with base-branch results, potentially clearing it without testing the PR again. Populate `PR_NUMBER` only for `pull_request` events.","comment_node_id":"PRRC_kwDOPenXVs8AAAABDgzs4w","finding_digest":"515ba5e4ae1bb7f09fba81b20b8a4207b354717fffe57137c275ceb304cf83d8","finding_id":"arf_v1_kfn2lzfodo37bh52qgzaxcsca6","finding_key":"github/workflows/integration-tests.yml::report-test-timings::pr-revision-only-comments","identity_key":"github/workflows/integration-tests.yml::report-test-timings::pr-revision-only-comments","line":93,"observation_digest":"6caaecceddbc7e78899f4dfa92ea28dd9af2579e8cfe5801f3443c0678d79ea6","observation_id":"aro_v1_nsvoztw5xr7hrcm7jx5jf2ri3w","path":".github/workflows/integration-tests.yml","prior_finding_id":"","published_at":"2026-11-10T21:22:10Z","review_id":"arr_v1_2chxp4nv7koqrajmjpr2oybeot","reviewed_base_sha":"1ee22dc943ea875864e479327193e51af7d24c34","reviewed_head_sha":"39c62db8dcefb21b486aaf021cf8a0ca31317993","reviewer":"codex","start_line":93,"suggestion_id":"arsg_v1_mcis4v2fc7oe5rv2zmdw6cwt2n"},"pull_request":{"number":1214},"record_id":"art_v1_7a6z6f5m2v64jnabsga4mxwor4","record_type":"finding_observed","recorded_at":"2026-11-10T21:22:10Z","repository":{"full_name":"aws/aws-durable-execution-sdk-js","id":1038735190},"schema_version":1}
