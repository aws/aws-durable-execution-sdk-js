{"data":{"body":"**[P2] Add automated runtime coverage for the React 19 renderer.** CI only installs, typechecks, and bundles `webview-ui`, while the extension's Jest configuration excludes this directory. A React major upgrade can therefore break mounting or Cloudscape modal/dropdown interactions without failing CI. Add a webview test that mounts `App` with React 19, exercises representative controls, and run it in the `insight-hosts` job.","comment_node_id":"PRRC_kwDOPenXVs79aXxO","finding_digest":"4ebb0dcc94bcbd84fe2f574b5cbe8c585ff5a54333b77f733279ed8f80d60453","finding_id":"arf_v1_j25q3teuxs6yj7rpk5fvzpumlb","finding_key":"packages/aws-durable-execution-sdk-js-insight-vscode/webview-ui/package.json::react-runtime::automated-test-coverage","identity_key":"packages/aws-durable-execution-sdk-js-insight-vscode/webview-ui/package.json::react-runtime::automated-test-coverage","line":17,"observation_digest":"f5136ed74bb80d0cee3e94efe90ef6b829003f8f3efb89290b17bac5e3fcd7b8","observation_id":"aro_v1_6ujw5v2lxagqz3r6stx6sdxwxa","path":"packages/aws-durable-execution-sdk-js-insight-vscode/webview-ui/package.json","prior_finding_id":"arf_v1_j25q3teuxs6yj7rpk5fvzpumlb","published_at":"2026-10-12T19:18:23Z","review_id":"arr_v1_jf6hxhb67trfrkrcen263q3vm6","reviewed_base_sha":"51d32001ecd72df54a9f846b262a36db2c17b6f5","reviewed_head_sha":"085ce8b7dc2684369a8e6b16392a247155616ca5","reviewer":"codex","start_line":16,"suggestion_id":""},"pull_request":{"number":991},"record_id":"art_v1_x7s2sy5lrsqqjuiuyfj3xbebta","record_type":"finding_observed","recorded_at":"2026-10-12T19:18:23Z","repository":{"full_name":"aws/aws-durable-execution-sdk-js","id":1038735190},"schema_version":1}
