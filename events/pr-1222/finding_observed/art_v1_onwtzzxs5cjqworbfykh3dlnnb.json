{"data":{"body":"[P2] Add committed tests for cleanup eligibility\n\nNo committed tests cover this deletion gate, stack filtering, or the new event-dependent naming. Inverting this condition would select open PR stacks without failing a test; the manual probe provides no regression protection. Add unit tests covering open/closed PRs, shared/unrelated stacks, dry-run and API failures, plus PR/target/non-PR naming, and wire them into CI as required by CONTRIBUTING rule 4.","comment_node_id":"PRRC_kwDOPenXVs8AAAABD6qypg","finding_digest":"17985e959ded82c7b9c195a9e962286388d5ae7b0e10c04d09c47e53b9c0a17c","finding_id":"arf_v1_c6mf5fm55wbmpoobswu6syrimo","finding_key":"integration-test/cleanup-pr-stacks.mjs::cleanup-selection::missing-branch-tests","identity_key":"integration-test/cleanup-pr-stacks.mjs::cleanup-selection::missing-branch-tests","line":116,"observation_digest":"8200161028d93688247761e7ac5d34ac9091f35f4898dc1328da5e121d4dc9a2","observation_id":"aro_v1_qiabmebi3e3iqjdxmht2yxjuvs","path":".github/workflows/scripts/integration-test/cleanup-pr-stacks.mjs","prior_finding_id":"arf_v1_c6mf5fm55wbmpoobswu6syrimo","published_at":"2026-11-12T23:41:41Z","review_id":"arr_v1_dtbhouhfhg4t2timuzzi5ezlu4","reviewed_base_sha":"48173acd2de943ce5fb43de8dd3683b9bcf8ab50","reviewed_head_sha":"846945b750b7748b7099a706065d47df43f261da","reviewer":"codex","start_line":116,"suggestion_id":""},"pull_request":{"number":1222},"record_id":"art_v1_onwtzzxs5cjqworbfykh3dlnnb","record_type":"finding_observed","recorded_at":"2026-11-12T23:41:41Z","repository":{"full_name":"aws/aws-durable-execution-sdk-js","id":1038735190},"schema_version":1}
