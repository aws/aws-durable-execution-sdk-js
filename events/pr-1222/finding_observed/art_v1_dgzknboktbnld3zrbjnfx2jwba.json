{"data":{"body":"[P2] Add committed tests for cleanup eligibility\n\nNo automated tests cover this deletion gate, stack filtering, or the new event-dependent naming. Inverting the closed-PR condition would select open PR stacks without failing any committed test; the manual probe provides no regression protection. Add unit tests covering open/closed PRs, shared/unrelated stacks, dry-run and API failures, plus PR/target/non-PR naming, and wire them into CI.","comment_node_id":"PRRC_kwDOPenXVs8AAAABD6kY8A","finding_digest":"17985e959ded82c7b9c195a9e962286388d5ae7b0e10c04d09c47e53b9c0a17c","finding_id":"arf_v1_c6mf5fm55wbmpoobswu6syrimo","finding_key":"integration-test/cleanup-pr-stacks.mjs::cleanup-selection::missing-branch-tests","identity_key":"integration-test/cleanup-pr-stacks.mjs::cleanup-selection::missing-branch-tests","line":116,"observation_digest":"f2aee155dc76cedf569511189118babf6c5acd741714cef58e1482164de49316","observation_id":"aro_v1_6kxocvo4o3hn6vuvcemjcgf2x5","path":".github/workflows/scripts/integration-test/cleanup-pr-stacks.mjs","prior_finding_id":"arf_v1_c6mf5fm55wbmpoobswu6syrimo","published_at":"2026-11-12T23:28:43Z","review_id":"arr_v1_f3px7zerddysc3jxak6zaakgii","reviewed_base_sha":"48173acd2de943ce5fb43de8dd3683b9bcf8ab50","reviewed_head_sha":"7d6c839fe1129488bbb8a7e24d06a6d790294bc2","reviewer":"codex","start_line":113,"suggestion_id":""},"pull_request":{"number":1222},"record_id":"art_v1_dgzknboktbnld3zrbjnfx2jwba","record_type":"finding_observed","recorded_at":"2026-11-12T23:28:43Z","repository":{"full_name":"aws/aws-durable-execution-sdk-js","id":1038735190},"schema_version":1}
