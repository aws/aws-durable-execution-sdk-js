{"data":{"body":"**[P1] Reject hosts that cannot supply the invocation-local carrier**\n\nSupported core versions 2.4\u20132.6 never add `xRayTraceId`, so this fallback still consumes a potentially stale `_X_AMZN_TRACE_ID` on Managed Instances. That can attach spans to another invocation's trace and even override a local `Sampled=0`. Require core 2.7+ for this plugin version, or negotiate a new plugin capability/API and reject hosts that cannot forward the carrier.","comment_node_id":"PRRC_kwDOPenXVs7-2lQ8","finding_digest":"7e75ebf10d41d9647a91b0f12c7a68203adaac2222feb9b1ce37ec5b543a20d5","finding_id":"arf_v1_pz26x4inihmwi6urwdysy6tiea","finding_key":"packages/aws-durable-execution-sdk-js-otel/package.json::core-peer::layer-host-compatibility-enforcement","identity_key":"packages/aws-durable-execution-sdk-js-otel/package.json::core-peer::layer-host-compatibility-enforcement","line":212,"observation_digest":"181a923752fd33285313303055cbbf228193c12e4f60abfbc4f71ec5808e05d9","observation_id":"aro_v1_danjen2s7uzsquytgayfls57ek","path":"packages/aws-durable-execution-sdk-js-otel/src/context-extractors.ts","prior_finding_id":"arf_v1_pz26x4inihmwi6urwdysy6tiea","published_at":"2026-10-14T20:10:19Z","review_id":"arr_v1_dgg7pchwdspvzvx52d6a5red7s","reviewed_base_sha":"240ab1de57d6b46af70a0fc9f4d97d84c55930e0","reviewed_head_sha":"6b0affa8c1a471ebf43fa6639b9728a12521ebf7","reviewer":"codex","start_line":212,"suggestion_id":""},"pull_request":{"number":955},"record_id":"art_v1_u7dfumeuehsn6psp7ugp7fwfdb","record_type":"finding_observed","recorded_at":"2026-10-14T20:10:19Z","repository":{"full_name":"aws/aws-durable-execution-sdk-js","id":1038735190},"schema_version":1}
